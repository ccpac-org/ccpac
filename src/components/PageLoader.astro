---
---
<div id="page-loader" class="fixed inset-0 z-[100] bg-[#030712] flex flex-col items-center justify-center transition-opacity duration-700 ease-out">
  <!-- Deep Space Nebula Glow in Loader -->
  <div class="absolute w-[500px] h-[500px] bg-gradient-to-r from-cyan-500/20 via-indigo-600/15 to-purple-600/20 blur-[140px] rounded-full pointer-events-none animate-pulse-glow"></div>

  <div class="relative z-10 flex flex-col items-center max-w-md px-6 text-center">
    <!-- Spinning Orbital Physics / Astronomy Logo -->
    <div class="relative w-32 h-32 mb-8 flex items-center justify-center">
      <!-- Outer Orbit Ring -->
      <div class="absolute inset-0 border-2 border-cyan-500/30 rounded-full animate-spin-slow"></div>
      <!-- Inner Reverse Orbit Ring -->
      <div class="absolute inset-3 border border-purple-500/30 rounded-full animate-spin-reverse-slow"></div>
      <!-- Core Pulsing Star / Sun -->
      <div class="absolute w-12 h-12 bg-gradient-to-tr from-cyan-400 to-indigo-500 rounded-full shadow-[0_0_25px_rgba(6,182,212,0.8)] animate-pulse-glow flex items-center justify-center">
        <span class="text-slate-950 font-black text-xl">ℏ</span>
      </div>
      <!-- Orbiting Particle -->
      <div class="absolute inset-0 animate-spin-slow">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3 h-3 bg-cyan-300 rounded-full shadow-[0_0_10px_#06b6d4]"></div>
      </div>
    </div>

    <!-- Title & Subtitle -->
    <h2 class="font-poppins font-bold text-2xl tracking-wider bg-gradient-to-r from-cyan-400 via-sky-200 to-purple-400 bg-clip-text text-transparent mb-2">
      CCPAC
    </h2>
    <p class="text-xs font-inter text-slate-400 uppercase tracking-[0.25em] mb-8">
      Chittagong College Physics & Astronomy Club
    </p>

    <!-- Progress / Loading Bar -->
    <div class="w-48 h-1 bg-slate-800/80 rounded-full overflow-hidden border border-cyan-500/20 shadow-[0_0_15px_rgba(6,182,212,0.1)]">
      <div id="loader-progress" class="h-full bg-gradient-to-r from-cyan-500 via-blue-500 to-purple-500 w-0 transition-all duration-300 ease-out shadow-[0_0_10px_#06b6d4]"></div>
    </div>

    <!-- Loading Status Text -->
    <p id="loader-status" class="mt-4 text-xs font-mono text-cyan-400/80 tracking-wider">
      INITIALIZING QUANTUM CORE...
    </p>
  </div>
</div>

<script is:inline>
  (function() {
    const loader = document.getElementById('page-loader');
    const progressBar = document.getElementById('loader-progress');
    const statusText = document.getElementById('loader-status');

    if (!loader || !progressBar) return;

    const phrases = [
      "CALIBRATING TELESCOPE ARRAYS...",
      "MAPPING STELLAR CONSTELLATIONS...",
      "COMPUTING QUANTUM WAVE EQUATIONS...",
      "INITIALIZING COSMIC CANVAS..."
    ];

    let progress = 10;
    progressBar.style.width = progress + '%';

    let phraseIdx = 0;
    const interval = setInterval(() => {
      progress += Math.floor(Math.random() * 25) + 15;
      if (progress >= 100) {
        progress = 100;
        clearInterval(interval);
        if (statusText) statusText.textContent = "LAUNCH SEQUENCE READY";
        setTimeout(() => {
          loader.style.opacity = '0';
          loader.style.pointerEvents = 'none';
          setTimeout(() => {
            loader.remove();
          }, 700);
        }, 350);
      }
      progressBar.style.width = progress + '%';
      if (phraseIdx < phrases.length && progress > (phraseIdx + 1) * 22) {
        phraseIdx++;
        if (statusText && phrases[phraseIdx]) {
          statusText.textContent = phrases[phraseIdx];
        }
      }
    }, 120);

    // Fallback in case window load takes longer or fires early
    window.addEventListener('load', () => {
      progress = 100;
      progressBar.style.width = '100%';
      if (statusText) statusText.textContent = "WELCOME TO CCPAC";
      setTimeout(() => {
        loader.style.opacity = '0';
        loader.style.pointerEvents = 'none';
        setTimeout(() => {
          loader.remove();
        }, 700);
      }, 200);
    });
  })();
</script>
