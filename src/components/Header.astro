---
interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Explore', href: '/#explore-section' },
  { name: 'Updates', href: '/#updates' },
  { name: 'Membership', href: '/#membership' },
  { name: 'Message Desk', href: '/#messages' },
  { name: 'Contact', href: '/#contact' },
];
---

<header id="main-navbar" class="sticky top-0 z-50 bg-slate-950/80 backdrop-blur-2xl border-b border-cyan-500/20 transition-all duration-300 shadow-xl shadow-cyan-950/20">
    <div class="max-w-7xl mx-auto px-6 py-3.5 flex justify-between items-center">
        <!-- Logo & Title -->
        <div class="flex-1 flex justify-start">
            <a href="/" class="flex items-center space-x-3 group">
                <div class="relative flex items-center justify-center">
                    <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-indigo-500 rounded-full blur-sm opacity-60 group-hover:opacity-100 transition duration-500 animate-pulse"></div>
                    <img src="/images/logo.png" alt="CCPAC Logo" class="relative w-10 h-10 rounded-full object-cover border-2 border-cyan-400/80 shadow-md shadow-cyan-500/30 crisp-img">
                </div>
                <div class="flex flex-col">
                    <span class="text-xl font-black tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-blue-400 to-indigo-300 font-poppins group-hover:text-cyan-300 transition">
                        CCPAC
                    </span>
                    <!-- <span class="text-[9px] font-bold text-cyan-400/80 tracking-widest uppercase -mt-1 font-sans hidden sm:inline">
                        Physics & Astronomy
                    </span> -->
                </div>
            </a>
        </div>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex space-x-6 text-xs sm:text-sm font-semibold tracking-wide text-slate-300">
            {navItems.map((item) => {
              const isActive = activePage === item.name.toLowerCase() || (item.name === 'Home' && activePage === 'home');
              return (
                <a 
                  href={item.href} 
                  class={isActive ? "text-cyan-400 font-bold px-3 py-1 rounded-lg bg-cyan-500/10 border border-cyan-500/30 shadow-sm shadow-cyan-500/20 transition flex items-center gap-1.5" : "hover:text-cyan-300 px-3 py-1 rounded-lg hover:bg-slate-900/60 transition flex items-center gap-1.5"}
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-cyan-400/80 inline-block opacity-0 group-hover:opacity-100"></span>
                  {item.name}
                </a>
              );
            })}
        </nav>

        <!-- Right Side Button & Mobile Toggle -->
        <div class="flex-1 flex justify-end items-center space-x-3">
            {currentPath === '/' && (
            <button onclick="toggleMembershipForm()" class="relative group inline-flex items-center justify-center p-[1px] rounded-xl overflow-hidden font-semibold text-xs sm:text-sm transition-all duration-300 cursor-pointer shadow-md shadow-cyan-500/10 hover:shadow-cyan-400/30">
                <span class="absolute inset-0 bg-gradient-to-r from-cyan-500 via-blue-500 to-indigo-500 group-hover:opacity-100 opacity-70 transition duration-300"></span>
                <span class="relative px-3.5 py-1.5 bg-slate-950 rounded-[11px] text-cyan-300 group-hover:text-white group-hover:bg-slate-950/40 transition-all duration-300 flex items-center gap-2">
                    <i class="fa-solid fa-atom text-cyan-400 group-hover:rotate-180 transition duration-500 text-xs"></i>
                    <span class="tracking-wider font-bold">JOIN CCPAC</span>
                </span>
            </button>
            )}
            
            <!-- Mobile Menu Toggle Button -->
            <button id="mobile-menu-btn" onclick="toggleMobileMenu()" class="md:hidden p-2 text-slate-300 hover:text-cyan-400 focus:outline-none rounded-lg bg-slate-900 border border-slate-800">
                <i class="fa-solid fa-bars text-lg"></i>
            </button>
        </div>
    </div>

    <!-- Mobile Navigation Dropdown -->
    <div id="mobile-menu" class="hidden md:hidden bg-slate-950/95 border-b border-cyan-500/20 px-6 py-4 space-y-3 font-medium text-sm">
        {navItems.map((item) => (
            <a href={item.href} onclick="toggleMobileMenu()" class="block py-2 px-3 text-slate-300 hover:text-cyan-400 hover:bg-slate-900 rounded-lg transition">
                {item.name}
            </a>
        ))}
    </div>
</header>

<script is:inline>
  function toggleMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    if (menu) {
      menu.classList.toggle('hidden');
    }
  }
</script>
