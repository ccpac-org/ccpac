---
interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Explore', href: '/#explore-section' },
  { name: 'Updates', href: '/#updates' },
  { name: 'Membership', href: '/#membership' },
  { name: 'Message Desk', href: '/#messages' },
  { name: 'Contact', href: '/#contact' },
];
---

<header class="sticky top-0 z-50 bg-spaceDark/90 backdrop-blur-xl border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
        <a href="/" class="flex items-center space-x-3">
            <img src="/images/logo.png" alt="CCPAC Logo" class="w-10 h-10 rounded-full object-cover border-2 border-cyan-400 shadow-md shadow-cyan-500/30 crisp-img">
            <span class="text-xl font-black tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400 font-poppins">CCPAC</span>
        </a>
        <nav class="hidden md:flex space-x-6 text-sm font-semibold tracking-wide text-slate-300">
            {navItems.map((item) => (
              <a 
                href={item.href} 
                class={activePage === item.name.toLowerCase() ? "text-cyan-400 font-bold transition" : "hover:text-cyan-400 transition"}
              >
                {item.name}
              </a>
            ))}
        </nav>
        <button onclick="toggleMembershipForm()" class="bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs sm:text-sm transition shadow-lg shadow-cyan-500/25 cursor-pointer inline-block text-center">
            Join CCPAC
        </button>
    </div>
</header>
