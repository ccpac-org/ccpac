            <ul class="space-y-2 text-xs">
                <li><a href="/" class="hover:text-cyan-400 transition">Home</a></li>
                <li><a href="/about" class="hover:text-cyan-400 transition">About Us</a></li>
                <li><a href="/#membership" class="hover:text-cyan-400 transition">Membership</a></li>
                <li><a href="/team" class="hover:text-cyan-400 transition">Executives</a></li>
