---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MembershipModal from '../components/MembershipModal.astro';
import CosmicCanvas from '../components/CosmicCanvas.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const {
  title = "CCPAC | Chittagong College Physics & Astronomy Club",
  description = "Promoting scientific literacy from subatomic scales to galactic horizons",
  activePage = "home"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{title}</title>

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="bg-spaceDark text-slate-100 font-sans selection:bg-cyan-500 selection:text-slate-950 overflow-x-hidden min-h-screen flex flex-col justify-between bg-space-grid relative">

    <!-- Interactive Canvas & Cosmic Starfield -->
    <CosmicCanvas />

    <!-- Layered Deep Space Nebula Glow Effects -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-[1500px] h-[600px] bg-gradient-to-r from-cyan-500/15 via-indigo-600/10 to-purple-600/15 blur-[160px] rounded-full pointer-events-none z-0"></div>
    <div class="fixed top-1/3 -left-40 w-[600px] h-[600px] bg-purple-600/10 blur-[180px] rounded-full pointer-events-none z-0"></div>
    <div class="fixed bottom-10 right-0 w-[600px] h-[600px] bg-cyan-600/10 blur-[180px] rounded-full pointer-events-none z-0"></div>

    <Header activePage={activePage} />

    <main class="relative z-10 flex-grow">
        <slot />
    </main>

    <Footer />

    <MembershipModal />

    <script is:inline>
        // Global helper to hide/show navbar when modals open/close
        function updateNavbarVisibility() {
            const navbar = document.getElementById('main-navbar');
            if (!navbar) return;
            
            // Check if any modal div (e.g. fixed inset-0 z-50 modals without 'hidden') is currently visible
            const allModals = document.querySelectorAll('div.fixed.inset-0');
            let anyModalOpen = false;
            allModals.forEach(modal => {
                if (!modal.classList.contains('hidden')) {
                    anyModalOpen = true;
                }
            });

            if (anyModalOpen) {
                navbar.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
            } else {
                navbar.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
            }
        }

        // MutationObserver to watch for modal class changes across the page
        const observer = new MutationObserver(() => {
            updateNavbarVisibility();
        });

        document.addEventListener('DOMContentLoaded', () => {
            // Observe all modal div elements in the document
            document.querySelectorAll('div.fixed.inset-0').forEach(modal => {
                observer.observe(modal, { attributes: true, attributeFilter: ['class'] });
            });
            updateNavbarVisibility();
        });
    </script>
</body>
</html>
