---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MembershipModal from '../components/MembershipModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const {
  title = "CCPAC | Chittagong College Physics & Astronomy Club",
  description = "Promoting scientific literacy from subatomic scales to galactic horizons",
  activePage = "home"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{title}</title>

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="bg-spaceDark text-slate-100 font-sans selection:bg-cyan-500 selection:text-slate-950 overflow-x-hidden min-h-screen flex flex-col justify-between">

    <!-- Glowing Background Effect -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1400px] h-[500px] bg-gradient-to-r from-cyan-500/10 via-blue-600/10 to-indigo-500/10 blur-[150px] rounded-full pointer-events-none z-0"></div>

    <Header activePage={activePage} />

    <main class="relative z-10 flex-grow">
        <slot />
    </main>

    <Footer />

    <MembershipModal />
</body>
</html>
