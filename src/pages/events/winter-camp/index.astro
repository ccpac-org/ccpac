    <!-- Lightbox Modal for Instructor Photo View -->
    <div id="lightboxModal" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="glass-card max-w-md w-full rounded-3xl border border-slate-800 shadow-2xl p-6 relative space-y-6 text-center">
            <button onclick="closeLightbox()" class="absolute top-4 right-4 bg-slate-900 hover:bg-cyan-500 hover:text-slate-950 text-slate-300 w-10 h-10 rounded-full flex items-center justify-center transition border border-slate-700 shadow-lg z-20 cursor-pointer" title="Close Lightbox">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
            <div class="w-full rounded-2xl overflow-hidden bg-slate-950 border border-slate-800 flex items-center justify-center pt-2">
                <img id="lightboxImg" src="" alt="Instructor Photo" class="max-h-[350px] w-auto object-contain crisp-img">
            </div>
            <div class="space-y-1">
                <span id="lightboxIndex" class="text-cyan-400 text-xs font-bold uppercase tracking-wider block"></span>
                <h3 id="lightboxName" class="text-xl font-black text-white font-poppins"></h3>
                <p id="lightboxRole" class="text-slate-400 text-sm"></p>
            </div>
            <button onclick="closeLightbox()" class="w-full py-3 bg-slate-800 hover:bg-slate-700 text-cyan-400 font-bold rounded-xl text-sm transition border border-slate-700 cursor-pointer">
                Close
            </button>
        </div>
    </div>

    <!-- Professional Popup Membership Registration Modal -->
    

    <!-- Professional Footer -->
    

    <!-- JavaScript for Form Toggle, Lightbox & Google Sheets Integration -->
    <script is:inline>
        function openLightbox(imgSrc, name, role, indexText) {
            document.getElementById('lightboxImg').src = imgSrc;
            document.getElementById('lightboxName').textContent = name;
            document.getElementById('lightboxRole').textContent = role;
            document.getElementById('lightboxIndex').textContent = indexText;
            document.getElementById('lightboxModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            document.getElementById('lightboxModal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        function toggleMembershipForm() {
            const formModal = document.getElementById('membership-registration');
            const isHidden = formModal.classList.contains('hidden');
            if (isHidden) {
                formModal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                formModal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }
        }

        document.getElementById('ccpacMembershipForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = {
                name: document.getElementById('mName').value,
                email: document.getElementById('mEmail').value,
                hscYear: document.getElementById('mHscYear').value,
                section: document.getElementById('mSection').value,
                roll: document.getElementById('mRoll').value,
                phone: document.getElementById('mPhone').value,
                whatsapp: document.getElementById('mWhatsapp').value,
                skills: Array.from(document.querySelectorAll('input[name="skills"]:checked')).map(cb => cb.value).join(', '),
                skillDetails: document.getElementById('mSkillDetails').value,
                olympiad: document.getElementById('mOlympiad').value,
                pastClub: document.getElementById('mPastClub').value,
                whyJoin: document.getElementById('mWhyJoin').value
            };

            const submitBtn = this.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Submitting...</span>`;
            submitBtn.disabled = true;

            try {
                const BACKEND_URL = 'https://script.google.com/macros/s/AKfycbxNKEqhdDrRqTE0rjpdgsH8THqHvwjzBEQGBcmQMnV1LiZIqac_MIBE7Vpob9kKrcw/exec';
                await fetch(BACKEND_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                document.getElementById('ccpacMembershipForm').style.display = 'none';
                document.getElementById('mSuccessBox').classList.remove('hidden');
            } catch (error) {
                console.error('Submission error:', error);
                alert('Something went wrong. Please try again later.');
                submitBtn.innerHTML = originalBtnText;
                submitBtn.disabled = false;
            }
        });
    </script>

</BaseLayout>