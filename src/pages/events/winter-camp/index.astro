---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Winter Physics Camp 2025 - CCPAC | Chittagong College Physics & Astronomy Club" activePage="explore">


    <!-- Glowing Background Effect -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1400px] h-[600px] bg-gradient-to-r from-cyan-500/10 to-blue-600/10 blur-[220px] rounded-full"></div>
    </div>

    <!-- Navigation Bar -->
    

    <!-- Back to Events -->
    <div class="max-w-6xl mx-auto px-6 pt-8">
        <a href="/events" class="inline-flex items-center space-x-2 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition font-sans">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to Events</span>
        </a>
    </div>

    <!-- Hero / Camp Banner Section -->
    <section class="max-w-4xl mx-auto px-6 pt-8 pb-10 text-center space-y-6">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">
            <i class="fa-solid fa-snowflake"></i>
            <span>Flagship Academic Program</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 uppercase font-poppins">
            Winter Physics Camp 2025
        </h1>
        
        <!-- Main Camp Banner Image -->
        <div class="w-full inline-block rounded-3xl border border-slate-800/80 shadow-2xl overflow-hidden bg-spaceCard p-2">
            <div class="w-full rounded-2xl overflow-hidden bg-slate-950 flex justify-center items-center">
                <img src="/images/wn.jpeg" alt="Winter Physics Camp 2025 Banner" class="w-full h-auto block crisp-img" onerror="this.src='https://i.ibb.co.com/xSmsb1tx/IMG-20260105-WA0001.jpg'">
            </div>
        </div>
    </section>

    <!-- Event Description & Schedule Section -->
    <section class="max-w-6xl mx-auto px-6 py-6 space-y-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <div class="lg:col-span-12 space-y-8">
                <!-- Description Card -->
                <div class="glass-card p-8 rounded-3xl border border-slate-800/80 shadow-2xl space-y-4 font-sans">
                    <h2 class="text-2xl font-black text-cyan-400 flex items-center space-x-3 font-poppins">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>Event Description</span>
                    </h2>
                    <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                        Chittagong College Physics & Astronomy Club presents Winter Physics Camp 2025 conducted by our honorable alumni. Designed to bridge foundational concepts with advanced problem-solving techniques.
                    </p>
                    <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800 text-xs sm:text-sm text-cyan-300 font-semibold">
                        <i class="fa-solid fa-clock mr-2 text-amber-400"></i> Overall Session Time: 10:00 AM – 12:15 PM<br>
                        <span class="text-slate-400 font-normal mt-1 block">Each day consists of two 1-hour sessions with a 15-minute break.</span>
                    </div>
                </div>

                <!-- Schedule Card -->
                <div class="glass-card p-8 rounded-3xl border border-slate-800/80 shadow-2xl space-y-6 font-sans">
                    <h2 class="text-2xl font-black text-cyan-400 flex items-center space-x-3 font-poppins">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span>Camp Schedule & Topics</span>
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-300">
                        <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80 flex flex-col justify-between gap-2 hover:border-cyan-500/50 transition">
                            <span class="text-cyan-400 font-bold"><i class="fa-regular fa-calendar mr-2"></i>23 Dec 2025</span>
                            <span class="text-slate-200 font-medium">Heat & Thermodynamics</span>
                        </div>
                        <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80 flex flex-col justify-between gap-2 hover:border-cyan-500/50 transition">
                            <span class="text-cyan-400 font-bold"><i class="fa-regular fa-calendar mr-2"></i>24 Dec 2025</span>
                            <span class="text-slate-200 font-medium">Work, Energy & Power</span>
                        </div>
                        <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80 flex flex-col justify-between gap-2 hover:border-cyan-500/50 transition">
                            <span class="text-cyan-400 font-bold"><i class="fa-regular fa-calendar mr-2"></i>27 Dec 2025</span>
                            <span class="text-slate-200 font-medium">Simple Harmonic Motion (SHM) & Waves</span>
                        </div>
                        <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80 flex flex-col justify-between gap-2 hover:border-cyan-500/50 transition">
                            <span class="text-cyan-400 font-bold"><i class="fa-regular fa-calendar mr-2"></i>28 Dec 2025</span>
                            <span class="text-slate-200 font-medium">Relativity & Quantum Mechanics</span>
                        </div>
                        <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80 flex flex-col justify-between gap-2 hover:border-cyan-500/50 transition">
                            <span class="text-cyan-400 font-bold"><i class="fa-regular fa-calendar mr-2"></i>29 Dec 2025</span>
                            <span class="text-slate-200 font-medium">Electricity & Magnetism, Newtonian Mechanics</span>
                        </div>
                        <div class="p-4 rounded-2xl bg-slate-950/60 border border-amber-500/40 flex flex-col justify-between gap-2 bg-gradient-to-r from-amber-500/10 to-transparent">
                            <span class="text-amber-400 font-bold"><i class="fa-regular fa-calendar mr-2"></i>30 Dec 2025</span>
                            <span class="text-white font-semibold">Winter Physics Mastery Test 2025 (Open Book Exam) & Wrap-Up</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Link to Camp Days Gallery Section -->
    <section class="max-w-6xl mx-auto px-6 py-4">
