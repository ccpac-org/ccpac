---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Camp Days - Winter Physics Camp 2025 | CCPAC | Chittagong College Physics & Astronomy Club" activePage="explore">


    <!-- Glowing Background Effect -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1400px] h-[600px] bg-gradient-to-r from-cyan-500/10 to-blue-600/10 blur-[220px] rounded-full"></div>
    </div>

    <!-- Navigation Bar -->
    

    <!-- Back to Camp Main Page -->
    <div class="max-w-6xl mx-auto px-6 pt-8">
        <a href="/events/winter-camp" class="inline-flex items-center space-x-2 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition font-sans">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to Winter Physics Camp 2025</span>
        </a>
    </div>

    <!-- Page Header -->
    <section class="max-w-5xl mx-auto px-6 pt-8 pb-6 text-center space-y-4">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">
            <i class="fa-solid fa-calendar-check"></i>
            <span>Detailed Event Logs</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 uppercase font-poppins">
            Camp Days Gallery & Highlights
        </h1>
        <p class="text-slate-400 text-sm max-w-2xl mx-auto font-sans">
            A day-by-day journey of Winter Physics Camp 2025 featuring sessions, instructors, and memorable moments.
        </p>
    </section>

    <!-- Main Camp Days Content Feed -->
    <section class="max-w-6xl mx-auto px-6 py-8 space-y-16 font-sans">

