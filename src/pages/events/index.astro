---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Events - CCPAC | Chittagong College Physics & Astronomy Club" activePage="explore">


    <!-- Glowing Background Effect -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1400px] h-[600px] bg-gradient-to-r from-cyan-500/10 to-blue-600/10 blur-[220px] rounded-full"></div>
    </div>

    <!-- Navigation Bar (Matched with Home Page) -->
    

    <!-- Hero Section / Events Intro -->
    <section class="max-w-5xl mx-auto px-6 pt-12 pb-10 text-center space-y-6">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">
            <i class="fa-solid fa-calendar-days"></i>
            <span>Academic & Intellectual Gatherings</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 uppercase font-poppins">
            Events
        </h1>
        
        <div class="glass-card p-6 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl text-slate-300 text-sm sm:text-base leading-relaxed text-left space-y-4 relative overflow-hidden font-sans">
            <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none"></div>
            <p class="relative z-10">
                CCPAC events are designed as immersive academic and intellectual gatherings where students explore <strong class="text-cyan-300">physics, astronomy, and related scientific concepts</strong> beyond the boundaries of textbooks, prioritizing theoretical understanding, analytical thinking and conceptual clarity over entertainment.
            </p>
            <p class="relative z-10">
                Through <strong class="text-cyan-300">workshops, lectures, and guided problem-solving</strong> in different scientific areas, students develop strong scientific reasoning. Mentorship from alumni and guest instructors provides research exposure and guidance for higher studies.
            </p>
            <p class="relative z-10">
                Emphasizing discipline and active participation, these events foster <strong class="text-cyan-300">teamwork, effective communication, and intellectual growth</strong>. Overall, CCPAC events cultivate a curious community dedicated to understanding the universe through logic and mathematics.
            </p>
        </div>
    </section>

    <!-- Upcoming / Featured Event Section (Winter Physics Camp 2025) -->
    <section class="max-w-6xl mx-auto px-6 py-8 space-y-12">
        <div class="text-center space-y-2">
            <h2 class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400 font-poppins">
                Featured Event
            </h2>
            <p class="text-slate-400 text-sm font-sans">Explore our signature academic camps and programs</p>
        </div>

        <!-- Winter Physics Camp 2025 Card -->
        <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl glow-box max-w-4xl mx-auto">
            <div class="grid md:grid-cols-12 gap-8 items-center">
                <div class="md:col-span-5 text-center md:text-left space-y-3">
                    <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase tracking-wider font-poppins">
                        Flagship Camp
                    </span>
                    <h3 class="text-2xl sm:text-3xl font-black text-white font-poppins">Winter Physics Camp 2025</h3>
                    <p class="text-slate-400 text-xs font-sans">An intensive winter camp focused on advanced problem solving and theoretical exploration.</p>
                </div>
                <div class="md:col-span-7 flex justify-center md:justify-end">
                    <a href="/events/winter-camp" class="inline-flex items-center space-x-3 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold px-8 py-4 rounded-2xl text-base transition shadow-lg shadow-cyan-500/25 font-poppins">
                        <span>Explore Winter Physics Camp 2025</span>
                        <i class="fa-solid fa-arrow-right text-sm"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Professional Popup Membership Registration Modal -->
    

    <!-- Professional Footer (Matched with Home Page) -->
    

    <!-- JavaScript for Form Toggle & Google Sheets Integration -->
    <script is:inline>
        function toggleMembershipForm() {
            const formModal = document.getElementById('membership-registration');
            const isHidden = formModal.classList.contains('hidden');
            if (isHidden) {
                formModal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                formModal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }
        }

        document.getElementById('ccpacMembershipForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = {
                name: document.getElementById('mName').value,
                email: document.getElementById('mEmail').value,
                hscYear: document.getElementById('mHscYear').value,
                section: document.getElementById('mSection').value,
                roll: document.getElementById('mRoll').value,
                phone: document.getElementById('mPhone').value,
                whatsapp: document.getElementById('mWhatsapp').value,
                skills: Array.from(document.querySelectorAll('input[name="skills"]:checked')).map(cb => cb.value).join(', '),
                whyJoin: document.getElementById('mWhyJoin').value
            };

            const submitBtn = this.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Submitting...</span>`;
            submitBtn.disabled = true;

            try {
                const BACKEND_URL = 'https://script.google.com/macros/s/AKfycbxNKEqhdDrRqTE0rjpdgsH8THqHvwjzBEQGBcmQMnV1LiZIqac_MIBE7Vpob9kKrcw/exec';
                await fetch(BACKEND_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                document.getElementById('ccpacMembershipForm').style.display = 'none';
                document.getElementById('mSuccessBox').classList.remove('hidden');
            } catch (error) {
                console.error('Submission error:', error);
                alert('Something went wrong. Please try again later.');
                submitBtn.innerHTML = originalBtnText;
                submitBtn.disabled = false;
            }
        });
    </script>

</BaseLayout>