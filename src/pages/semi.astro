---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CCPAC Semi-final Special" activePage="explore">


<div class="poster">
    <!-- Header (Logo: 3.jpg) -->
    <div class="header">
        <img class="club-logo" src="https://i.postimg.cc/V0Ytxhjx/3.jpg" alt="CCPAC Logo">
        <div class="club-name">Chittagong College Physics & Astronomy Club</div>
        <div class="subtitle">CCPAC Presents</div>
        <div class="badge-container">
            <span class="badge-text">🏆 World Cup 2026 Semi-final Special 🏆</span>
        </div>
    </div>

    <!-- Match Title -->
    <div class="match-title">
        FIFA World Cup 2026 Semifinal <br>
        <span class="match-vs">আর্জেন্টিনা বনাম ইংল্যান্ড</span>
    </div>

    <!-- Match Background -->
    <div class="section-box">
        <div class="section-title">⚽ ম্যাচ ব্যাকগ্রাউন্ড</div>
        <p>
            ২০২৬ সালের ফিফা বিশ্বকাপের দ্বিতীয় সেমিফাইনালে মুখোমুখি হয়েছে দুই চিরপ্রতিদ্বন্দ্বী আর্জেন্টিনা ও ইংল্যান্ড। ম্যাচের বয়স তখন ৮৫ মিনিট। গ্যালারিজুড়ে রুদ্ধশ্বাস উত্তেজনা, স্কোরলাইন ১-১ গোলে ড্র। ঠিক এই মুহূর্তে ইংল্যান্ডের ডি-বক্সের ঠিক বাইরে একটি ফ্রি-কিক পেল আর্জেন্টিনা। বলটি গোলপোস্ট থেকে ঠিক <strong>r = 25 m</strong> দূরে মাটিতে স্থির অবস্থায় আছে।
        </p>
        <p style="margin-top: 10px; color: #a5b4fc; font-weight: 600;">
            নিচে মাঠের পরপর ঘটে যাওয়া তিনটি ঘটনার ক্রমানুসার দেওয়া হলো। ফিজিক্সের গতিবিদ্যা ও ভেক্টরের সূত্র ব্যবহার করে ঘটনাগুলোর গাণিতিক সত্যতা যাচাই করো:
        </p>
    </div>

    <!-- Chronology / Timeline -->
    <div class="timeline">
        <!-- Event 1 -->
        <div class="event-card">
            <div class="event-title">ঘটনা ১: মেসির সেই "ম্যাজিকাল ফ্রি-কিক"</div>
            <p>শট নেওয়ার জন্য পজিশন নিলেন লিওনেল মেসি। তিনি বলটিকে এমনভাবে কিক করলেন যেন তা প্রাসের গতিপথ (Projectile Motion) বজায় রেখে ঠিক <strong>1.5 s</strong> পর ইংল্যান্ডের গোলপোস্টে পৌঁছায়। বলটি যখন বাতাসে তার গতিপথের সর্বোচ্চ বিন্দুতে উঠেছিল, ঠিক তখন বলটির উলম্ব বেগ (v<sub>y</sub>) শূন্য হয়ে যায়।</p>
        </div>

        <!-- Event 2 -->
        <div class="event-card">
            <div class="event-title">ঘটনা ২: বেলিংহামের আকাশছোঁয়া ডিফেন্স লাইন</div>
            <p>মেসির কিক করা বলটি যখন বাতাসে ভাসছে, তখন বলের গতিপথের ঠিক মাঝখানে (গোলপোস্ট থেকে <strong>12.5 m</strong> সামনে) মানবপ্রাচীরে দাঁড়িয়ে থাকা জুড বেলিংহাম বলটি ক্লিয়ার করার জন্য লাফিয়ে উঠলেন। বেলিংহামের উচ্চতা এবং লাফানোর ক্ষমতা মিলিয়ে তিনি সর্বোচ্চ <strong>2.9 m</strong> উচ্চতা পর্যন্ত বলের নাগাল পেতে পারেন।</p>
        </div>

        <!-- Event 3 -->
        <div class="event-card">
            <div class="event-title">ঘটনা ৩: রিবাউন্ড ও কেইন-আলভারেজের রুদ্ধশ্বাস দৌড়</div>
            <p>বলটি ডিফেন্সের ওপর দিয়ে গিয়ে ইংল্যান্ডের গোলপোস্টের ক্রসবারে লেগে রিবাউন্ড হয়ে (ফিরে এসে) মাঠের ডান প্রান্তে পড়ে। সেখানে ওত পেতে থাকা আর্জেন্টিনার উইঙ্গার হুলিয়ান আলভারেজ <strong>10 ms<sup>-1</sup></strong> বেগে বলটি নিয়ে গোলপোস্টের সমান্তরালে সাইডলাইন ধরে দৌড়াতে শুরু করেন। ঠিক তখনই আলভারেজ থেকে <strong>12 m</strong> দূরে থাকা ইংল্যান্ডের অধিনায়ক হ্যারি কেইন আলভারেজের দৌড়ের দিকের সাথে <strong>120°</strong> কোণে <strong>8 ms<sup>-1</sup></strong> বেগে তাঁকে ট্যাকল করতে ছুটে আসেন।</p>
        </div>
    </div>

    <p style="text-align: center; font-size: 0.9rem; color: #a5b4fc; margin-bottom: 25px;">
        *(ধরে নাও, অভিকর্ষজ ত্বরণ <strong>g = 10 ms<sup>-2</sup></strong> এবং বাতাসের বাধা উপেক্ষণীয়)*
    </p>

    <!-- Match Action Images (1.jpg and 2.jpg) -->
    <div class="image-gallery">
        <img class="gallery-img" src="https://i.postimg.cc/sGVWkLpm/1.jpg" alt="Match Action 1">
        <img class="gallery-img" src="https://i.postimg.cc/7JxzFRgd/2.jpg" alt="Match Action 2">
    </div>

    <!-- Questions Section -->
    <div class="section-box" style="background: rgba(0, 242, 254, 0.01); border-color: rgba(0, 242, 254, 0.15);">
        <div class="section-title">❓ চ্যালেঞ্জসমূহ</div>

        <!-- Q1 -->
        <div class="question-card">
            <div class="question-tag">প্রশ্ন (ক)</div>
            <p>মেসি যখন বলটিতে কিক করেছিলেন, তখন বলটির আদি বেগ (v<sub>0</sub>) কত ছিল এবং অনুভূমিকের সাথে কত কোণে (&theta;<sub>0</sub>) কিক করতে হয়েছিল?</p>
        </div>

        <!-- Q2 -->
        <div class="question-card">
            <div class="question-tag">প্রশ্ন (খ)</div>
            <p>ফিজিক্সের হিসেব অনুযায়ী, বলটি যখন বেলিংহামের মাথার ওপর দিয়ে যাচ্ছিল (ঠিক মাঝপথে), তখন কি বেলিংহামের লাফিয়ে উঠে বলটি ডিফ্লেক্ট বা ব্লক করার কোনো সুযোগ ছিল? গাণিতিকভাবে বিশ্লেষণ করো।</p>
        </div>

        <!-- Q3 -->
        <div class="question-card">
            <div class="question-tag">প্রশ্ন (গ)</div>
            <p>কেইনের সাপেক্ষে আলভারেজের আপেক্ষিক বেগের মান ও দিক কত হবে? কেইন যদি আলভারেজকে ট্যাকল করতে চান, তবে কেইন আলভারেজের সর্বোচ্চ কতটা কাছাকাছি পৌঁছাতে পারবেন (অর্থাৎ তাদের মধ্যকার সর্বনিম্ন দূরত্ব কত হবে)?</p>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer-tag">
        © CHITTAGONG COLLEGE PHYSICS & ASTRONOMY CLUB
    </div>
</div>


</BaseLayout>
