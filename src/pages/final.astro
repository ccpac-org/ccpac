---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CCPAC Grand Final Special" activePage="explore">


<div class="poster">
    <!-- Header -->
    <div class="header">
        <img class="club-logo" src="https://i.postimg.cc/V0Ytxhjx/3.jpg" alt="CCPAC Logo">
        <div class="club-name">Chittagong College Physics & Astronomy Club</div>
        <div class="subtitle">CCPAC Presents</div>
        <div class="badge-container">
            <span class="badge-text">🏆 World Cup 2026 Final Special 🏆</span>
        </div>
    </div>

    <!-- Match Title -->
    <div class="match-title">
        FIFA World Cup 2026 Grand Final <br>
        <span class="match-vs">স্পেন বনাম আর্জেন্টিনা</span>
    </div>

    <!-- Match Meta Details Section -->
    <div class="match-meta-box">
        <div class="meta-item">🗓️ <strong>তারিখ:</strong> ২০ জুলাই, ২০২৬ (সোমবার)</div>
        <div class="meta-item">⏰ <strong>কিক-অফ:</strong> রাত ০১:০০ টা (বাংলাদেশ সময়)</div>
        <div class="meta-item">🏟️ <strong>ভেন্যু:</strong> মেটলাইফ স্টেডিয়াম, নিউ জার্সি (ইউএসএ)</div>
    </div>

    <!-- ================= LAYER 1: REGULAR MATCH SITUATION ================= -->
    <div class="layer-heading">🛡️ লামিন ইয়ামাল বনাম আলবিসেলেস্তে ডিফেন্স (Regular Match)</div>
     
    <div class="section-box">
        <div class="section-title">⚽ ম্যাচ ব্যাকগ্রাউন্ড ১: মেটলাইফের মহাকাব্যিক থ্রিলার</div>
        <p>
            বাংলাদেশের চিরসবুজ গালিচা আর মনকাড়া প্রকৃতি থেকে ঠিক ১২,৬৮৫ কিলোমিটার দূরে, সুদূর আমেরিকার নিউ জার্সির মেটলাইফ স্টেডিয়ামে বসেছে বিশ্ব ফুটবলের সবচেয়ে জমকালো আসর। ঘড়ির কাঁটায় তখন বাংলাদেশ সময় ২০ জুলাই, ২০২৬-এর ঠিক রাত ১:০০ টা। মুখোমুখি ডিফেন্ডিং চ্যাম্পিয়ন আর্জেন্টিনা এবং ইউরোপসেরা স্পেন। একদিকে আলবিসেলেস্তেদের মুকুট ধরে রাখার নিখুঁত প্রেস, অন্যদিকে লা রোহাদের গতিময় ফুটবল। কিন্তু এই রাজকীয় লড়াইয়ের পরতে পরতে লুকিয়ে আছে বলবিদ্যার কিছু জটিল সমীকরণ। মাঠের সেই টানটান উত্তেজনার দুটি দৃশ্যপট নিচে দেওয়া হলো:
        </p>
    </div>

    <div class="timeline">
        <!-- Event 1: Brittakar & Friction -->
        <div class="event-card">
            <div class="event-title">ঘটনা ১: লামিন ইয়ামাল ও দানি ওলমোর বৃত্তাকার কম্বিনেশন এবং ডি পলের ডিফেন্স</div>
            <p>স্পেনের বিস্ময়বালক লামিন ইয়ামাল <strong>ভর 72 kg</strong> নিয়ে মাঠের ডান প্রান্ত দিয়ে <strong>6 ms⁻¹</strong> সমবেগে <strong>4 m</strong> ব্যাসার্ধের একটি বৃত্তাকার বক্রপথে উইং ধরে ড্রিবলিং করে ডিফেন্ডারকে পরাস্ত করেন এবং ফাঁকায় থাকা দানি ওলমোকে পাস দেন। ওলমো বলটি রিসিভ করে দিক পরিবর্তন করার মুহূর্তেই আর্জেন্টিনার রদ্রিগো ডি পল ওলমোকে থামাতে মাঠের সমান্তরালে ছুটে এসে বডি ট্যাকল করার চেষ্টা করেন। স্প্যানিশ ফরোয়ার্ডদের এই তীব্র ঘূর্ণন গতি বজায় রাখতে বুট ও মাঠের ঘাসের মধ্যকার স্থিতি ঘর্ষণ বলই একমাত্র ভরসা।</p>
        </div>

        <!-- Event 2: Linear Dynamics / Mechanics -->
        <div class="event-card">
            <div class="event-title">ঘটনা ২: মেসির পাস, লাউতারোর বুলেট শট ও জালের স্প্রিং অ্যাকশন</div>
            <p>মাঝমাঠ থেকে লিওনেল মেসি জাদুকরী ড্রিবলিংয়ে বল পাস করলেন লাউতারো মার্টিনেজের উদ্দেশ্যে। লাউতারো ডি-বক্সের ভেতর স্থির থাকা <strong>450 g</strong> ভরের বলটিতে বুট দিয়ে প্রচণ্ড জোরে কিক করলেন। তার পা বলটির সংস্পর্শে মাত্র <strong>0.015 s</strong> ছিল এবং বলটি <strong>32 ms⁻¹</strong> অনুভূমিক বেগে গোলপোস্টের দিকে ছুটে যায়। বলটি গোলপোস্টের নাইলনের জালে আঘাত করা মাত্র জালটি একটি আদর্শ স্প্রিংয়ের মতো আচরণ করে সংকুচিত হয়ে বলটিকে থামিয়ে দেয়। জালের স্প্রিং ধ্রুবক <strong>k = 4608 Nm⁻¹</strong>።</p>
        </div>
    </div>

    <!-- ================= LAYER 2: PENALTY SHOOTOUT (TIE BREAKER) ================= -->
    <div class="layer-heading">🧤 লেয়ার ২: টাইব্রেকার থ্রিলার (Penalty Shootout)</div>
     
    <div class="section-box">
        <div class="section-title">⚽ ম্যাচ ব্যাকগ্রাউন্ড ২: ১২০ মিনিটের মহানাটক ও স্পট কিক</div>
        <p>
            নির্ধারিত ও অতিরিক্ত সময় শেষেও ম্যাচ ৩-৩ সমতায় শেষ হওয়ায় মেটলাইফ স্টেডিয়ামের ভাগ্য নির্ধারণের খেলা গড়াল টাইব্রেকারে। স্নায়ুচাপের এই চূড়ান্ত মুহূর্তে কিকারের শটের লিনিয়ার মেকানিক্স এবং গোলরক্ষকের রৈখিক গতির হিসাবই গড়ে দেবে ব্যবধান।
        </p>
    </div>

    <div class="timeline">
        <!-- Event 3: Pure Mechanics & Kinematics -->
        <div class="event-card">
            <div class="event-title">ঘটনা ৩: এমি মার্টিনেজের বাজপাখি ডাইভ</div>
            <p>টাইব্রেকারের শেষ ও নিষ্পত্তিমূলক শট নিতে এলেন স্পেনের তারকা মিডফিল্ডার রদ্রি। গোলপোস্টের ঠিক <strong>11 m</strong> দূরে থাকা পেনাল্টি স্পট থেকে তিনি বলটিকে অনুভূমিকভাবে সরাসরি পোস্টের ডান কোণা লক্ষ্য করে শট নিলেন। বলটি শট হওয়ার সাথে সাথে <strong>0.25 s</strong> এর মধ্যে গোললাইন অতিক্রম করার জন্য ধাবিত হয়। আর্জেন্টিনার বাজপাখি গোলরক্ষক এমিলিয়ানো মার্টিনেজ বল ছুটার ঠিক <strong>0.05 s</strong> পর (রিফ্লেক্স টাইম) গোলপোস্টের মাঝখান থেকে ডানদিকে <strong>6 ms⁻¹</strong> সুষম বেগে ঝাঁপিয়ে পড়লেন। গোলপোস্টের কেন্দ্র থেকে ডান কোণার দূরত্ব <strong>3.66 m</strong>।</p>
        </div>
    </div>

    <p style="text-align: center; font-size: 0.95rem; color: #a5b4fc; margin-bottom: 30px;">
        *(ধরে নাও, অভিকর্ষজ ত্বরণ <strong>g = 9.8 ms⁻²</strong>, সমস্ত শক্তি লস উপেক্ষণীয় এবং অনুভূমিক গতির ক্ষেত্রে বাতাসের বাধা নেই)*
    </p>

    <!-- 🌟 ইমেজ গ্যালারি 🌟 -->
    <div class="image-gallery">
        <div class="gallery-box">
            <img class="gallery-img" src="https://i.postimg.cc/rw2Qdcjs/images.jpg" alt="Final Action 3">
        </div>
        <div class="gallery-box">
            <img class="gallery-img" src="https://i.postimg.cc/VkMsR9Xz/749300541-122218644314370992-7887761982620472799-n.jpg" alt="Final Action 4">
        </div>
    </div>

    <!-- Questions Section -->
    <div class="section-box" style="background: rgba(255, 75, 75, 0.01); border-color: rgba(255, 75, 75, 0.15);">
        <div class="section-title">❓ মেকানিক্স ও স্প্রিং চ্যালেঞ্জ (Double Layer Physics Challenges)</div>

        <!-- Part 1 Questions -->
        <div style="margin-bottom: 25px;">
            <h4 style="color: #ffb443; margin-bottom: 10px; font-size: 1.1rem;">🔹 পার্ট-১: অন-ফিল্ড গতি ও শক্তি বিশ্লেষণ (Regular Match)</h4>
            <div class="question-card">
                <div class="question-tag">প্রশ্ন (ক)</div>
                <p>ঘটনা ১ অনুযায়ী, লামিন ইয়ামাল যখন বক্রপথে বাঁক নিচ্ছিলেন তখন তার ওপর প্রযুক্ত কেন্দ্রমুখী বলের (Centripetal Force) মান কত ছিল? ইয়ামাল যদি না পিছলে ওই নির্দিষ্ট বেগে মোড় শেষ করতে চান, তবে বুট ও মাঠের ঘাসের মধ্যকার ন্যূনতম স্থিতি ঘর্ষণ গুণাঙ্ক (&mu;<sub>s</sub>) কত হতে হবে?</p>
            </div>
            <div class="question-card">
                <div class="question-tag">প্রশ্ন (খ)</div>
                <p>ঘটনা ২ এর তথ্যের ভিত্তিতে, লাউতারো মার্টিনেজের শটের কারণে বলের ওপর প্রযুক্ত বলের ঘাত (Impulse) এবং গড় বলের (Average Force) মান নির্ণয় করো। কাজ-শক্তি উপপাদ্য ব্যবহার করে বলটি জালের সংস্পর্শে এসে স্থির হওয়ার পূর্ব পর্যন্ত গোলপোস্টের জালটি সর্বোচ্চ কত দূরত্ব (x) সংকুচিত হয়েছিল তা বের করো।</p>
            </div>
        </div>

        <!-- Part 2 Questions -->
        <div>
            <h4 style="color: #ffb443; margin-bottom: 10px; font-size: 1.1rem;">🔹 পার্ট-২: টাইব্রেকার ও লিনিয়ার মেকানিক্স (Tie Breaker)</h4>
            <div class="question-card">
                <div class="question-tag">প্রশ্ন (গ)</div>
                <p>ঘটনা ৩ এর ডেটা থেকে রদ্রির শট করা বলটির অনুভূমিক বেগ নির্ণয় করো। রৈখিক গতিবিদ্যার সূত্র ও সময় ব্যবহার করে গাণিতিকভাবে বিশ্লেষণ করো যে, এমি মার্টিনেজ বলটি গোললাইন অতিক্রম করার আগেই তার নাগাল পাবেন কি না, অর্থাৎ আর্জেন্টিনা কি বিশ্বচ্যাম্পিয়ন হতে পারবে?</p>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer-tag">
        &copy; CHITTAGONG COLLEGE PHYSICS & ASTRONOMY CLUB
    </div>
</div>


</BaseLayout>
