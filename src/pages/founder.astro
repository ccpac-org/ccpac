---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Founders - CCPAC | Chittagong College Physics & Astronomy Club" activePage="explore">


    <!-- Glowing Background Effect -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1400px] h-[600px] bg-cyan-500/10 blur-[200px] rounded-full pointer-events-none"></div>

    <!-- Navigation Bar -->
    

    <!-- Founders Hero Section -->
    <section class="max-w-5xl mx-auto px-6 pt-20 pb-14 text-center space-y-4">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">
            <i class="fa-solid fa-award"></i>
            <span>Visionaries & Trailblazers</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 font-poppins">
            CCPAC Founders
        </h1>
        <p class="text-slate-300 text-base sm:text-lg max-w-3xl mx-auto leading-relaxed font-sans">
            Meet the Founders of Chittagong College Physics & Astronomy Club. The strength of CCPAC begins with three trailblazers whose achievements span from national excellence to international physics and astronomy stages, where they have represented Bangladesh with distinction.
        </p>
    </section>

    <!-- Founders Profiles Showcase -->
    <section class="max-w-6xl mx-auto px-6 py-10 space-y-16">

        <!-- Founder 1: Mohammad Abdullah -->
        <div class="glass-card p-8 sm:p-12 rounded-3xl border border-slate-800/80 shadow-2xl relative overflow-hidden glow-box">
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="grid lg:grid-cols-12 gap-10 items-center">
                <div class="lg:col-span-5 relative">
                    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-40 transition duration-500"></div>
                    <img src="/images/f1.jpeg" alt="Mohammad Abdullah" class="relative w-full h-[400px] object-cover rounded-2xl border-2 border-cyan-500/40 shadow-2xl crisp-img">
                </div>
                <div class="lg:col-span-7 space-y-6">
                    <div>
                        <span class="text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">Founding Pioneer</span>
                        <h2 class="text-3xl sm:text-4xl font-black text-white mt-1 font-poppins">Mohammad Abdullah</h2>
                    </div>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-slate-300 text-sm font-sans">
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-graduation-cap text-cyan-400"></i>
                            <span class="font-medium">Chittagong College ’24</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-earth-americas text-cyan-400"></i>
                            <span class="font-medium">APhO 2023 Participant</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-atom text-cyan-400"></i>
                            <span class="font-medium">IPhO TST Camper</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-trophy text-cyan-400"></i>
                            <span class="font-medium">3× BdPhO National Winner</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner sm:col-span-2">
                            <i class="fa-solid fa-star text-cyan-400"></i>
                            <span class="font-medium">BdOAA National Winner</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Founder 2: Rahul Nandi -->
        <div class="glass-card p-8 sm:p-12 rounded-3xl border border-slate-800/80 shadow-2xl relative overflow-hidden glow-box">
            <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="grid lg:grid-cols-12 gap-10 items-center">
                <div class="lg:col-span-7 space-y-6 order-2 lg:order-1">
                    <div>
                        <span class="text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">Founding Pioneer</span>
                        <h2 class="text-3xl sm:text-4xl font-black text-white mt-1 font-poppins">Rahul Nandi</h2>
                    </div>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-slate-300 text-sm font-sans">
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-graduation-cap text-cyan-400"></i>
                            <span class="font-medium">Chittagong College ’25</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-medal text-cyan-400"></i>
                            <span class="font-medium">Bangladesh's First EuPhO Honourable Mention 2024</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-award text-cyan-400"></i>
                            <span class="font-medium">APhO 2025 Honourable Mention</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-shield-halved text-cyan-400"></i>
                            <span class="font-medium">Physics Cup 2025 Bronze Medalist</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-atom text-cyan-400"></i>
                            <span class="font-medium">IPhO TST Camper</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-trophy text-cyan-400"></i>
                            <span class="font-medium">BdPhO 2025 National Champion</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-trophy text-cyan-400"></i>
                            <span class="font-medium">5× BdPhO National Winner</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-star text-cyan-400"></i>
                            <span class="font-medium">2× BdOAA National Winner</span>
                        </li>
                    </ul>
                </div>
                <div class="lg:col-span-5 relative order-1 lg:order-2">
                    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-40 transition duration-500"></div>
                    <img src="/images/f2.jpeg" alt="Rahul Nandi" class="relative w-full h-[400px] object-cover rounded-2xl border-2 border-cyan-500/40 shadow-2xl crisp-img">
                </div>
            </div>
        </div>

        <!-- Founder 3: Aditya Das Jitu -->
        <div class="glass-card p-8 sm:p-12 rounded-3xl border border-slate-800/80 shadow-2xl relative overflow-hidden glow-box">
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="grid lg:grid-cols-12 gap-10 items-center">
                <div class="lg:col-span-5 relative">
                    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-40 transition duration-500"></div>
                    <img src="/images/f3.jpeg" alt="Aditya Das Jitu" class="relative w-full h-[400px] object-cover rounded-2xl border-2 border-cyan-500/40 shadow-2xl crisp-img">
                </div>
                <div class="lg:col-span-7 space-y-6">
                    <div>
                        <span class="text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">Founding Pioneer</span>
                        <h2 class="text-3xl sm:text-4xl font-black text-white mt-1 font-poppins">Aditya Das Jitu</h2>
                    </div>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-slate-300 text-sm font-sans">
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-graduation-cap text-cyan-400"></i>
                            <span class="font-medium">Chittagong College ’25</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-medal text-cyan-400"></i>
                            <span class="font-medium">Bangladesh's First APhO Bronze Medalist 2025</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-award text-cyan-400"></i>
                            <span class="font-medium">Physics Cup 2025 Honorable Mention</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-earth-americas text-cyan-400"></i>
                            <span class="font-medium">APhO 2024 & EuPhO 2024 Participant</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-atom text-cyan-400"></i>
                            <span class="font-medium">IPhO TST Camper</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner">
                            <i class="fa-solid fa-trophy text-cyan-400"></i>
                            <span class="font-medium">3× BdPhO National Winner</span>
                        </li>
                        <li class="achievement-pill bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 flex items-center space-x-3 shadow-inner sm:col-span-2">
                            <i class="fa-solid fa-star text-cyan-400"></i>
                            <span class="font-medium">2× BdOAA National Winner</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

    </section>

    <!-- Professional Popup Membership Registration Modal -->
    

    <!-- Professional Footer -->
    

    <!-- JavaScript for Membership Form -->
    <script is:inline>
        // Toggle Membership Form Visibility
        function toggleMembershipForm() {
            const formModal = document.getElementById('membership-registration');
            const isHidden = formModal.classList.contains('hidden');
            
            if (isHidden) {
                formModal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                formModal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }
        }

        // Form Handler Script with Google Sheets Integration
        document.getElementById('ccpacMembershipForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = {
                name: document.getElementById('mName').value,
                email: document.getElementById('mEmail').value,
                hscYear: document.getElementById('mHscYear').value,
                section: document.getElementById('mSection').value,
                roll: document.getElementById('mRoll').value,
                phone: document.getElementById('mPhone').value,
                whatsapp: document.getElementById('mWhatsapp').value,
                skills: Array.from(document.querySelectorAll('input[name="skills"]:checked')).map(cb => cb.value).join(', '),
                skillDetails: document.getElementById('mSkillDetails').value,
                olympiad: document.getElementById('mOlympiad').value,
                pastClub: document.getElementById('mPastClub').value,
                whyJoin: document.getElementById('mWhyJoin').value
            };

            const submitBtn = this.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Submitting...</span>`;
            submitBtn.disabled = true;

            try {
                const BACKEND_URL = 'https://script.google.com/macros/s/AKfycbxNKEqhdDrRqTE0rjpdgsH8THqHvwjzBEQGBcmQMnV1LiZIqac_MIBE7Vpob9kKrcw/exec';

                await fetch(BACKEND_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                document.getElementById('ccpacMembershipForm').style.display = 'none';
                document.getElementById('mSuccessBox').classList.remove('hidden');

            } catch (error) {
                console.error('Submission error:', error);
                alert('Something went wrong. Please try again later.');
                submitBtn.innerHTML = originalBtnText;
                submitBtn.disabled = false;
            }
        });
    </script>

</BaseLayout>
