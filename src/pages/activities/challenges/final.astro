---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="World Cup 2026 Grand Final Special - CCPAC" activePage="explore">

    <!-- Glowing Background Effect -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1400px] h-[600px] bg-red-500/10 blur-[200px] rounded-full pointer-events-none"></div>

    <!-- Main Container -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 space-y-8 relative z-10">
        
        <!-- Back Navigation -->
        <div>
            <a href="/activities/challenges" class="inline-flex items-center space-x-2 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition font-sans group">
                <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
                <span>Back to Challenges</span>
            </a>
        </div>

        <!-- Poster Header Card -->
        <header class="glass-card p-6 sm:p-10 rounded-3xl border border-red-500/30 shadow-2xl text-center space-y-6 relative overflow-hidden glow-box">
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-red-500/10 rounded-full blur-3xl pointer-events-none"></div>
            
            <!-- Logo & Club Info -->
            <div class="flex flex-col items-center justify-center space-y-3">
                <img class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl  shadow-xl object-cover crisp-img" src="/images/logo.png" alt="CCPAC Logo">
                <h2 class="text-sm sm:text-base font-bold text-red-400 tracking-wider uppercase font-poppins">Chittagong College Physics & Astronomy Club</h2>
                <span class="text-xs text-slate-400 uppercase tracking-widest font-sans font-medium">CCPAC Presents</span>
                <div class="inline-block px-4 py-1.5 rounded-full bg-red-500/10 border border-red-500/30 text-amber-300 text-xs sm:text-sm font-bold shadow-sm font-poppins">
                    🏆 World Cup 2026 Final Special 🏆
                </div>
            </div>

            <!-- Match Title -->
            <div class="space-y-2 pt-2 border-t border-slate-800/80">
                <h1 class="text-2xl sm:text-4xl font-black text-white font-poppins tracking-tight">
                    FIFA World Cup 2026 Grand Final
                </h1>
                <div class="text-2xl sm:text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-red-400 via-amber-400 to-yellow-300 font-poppins">
                    স্পেন বনাম আর্জেন্টিনা
                </div>
            </div>

            <!-- Match Meta Details Section -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 text-xs sm:text-sm font-sans text-slate-300 bg-slate-950/60 p-4 rounded-2xl border border-slate-800">
                <div class="flex items-center justify-center space-x-2">
                    <span>🗓️</span>
                    <span><strong>তারিখ:</strong> ২০ জুলাই, ২০২৬ (সোমবার)</span>
                </div>
                <div class="flex items-center justify-center space-x-2">
                    <span>⏰</span>
                    <span><strong>কিক-অফ:</strong> রাত ০১:০০ টা (বাংলাদেশ সময়)</span>
                </div>
                <div class="flex items-center justify-center space-x-2">
                    <span>🏟️</span>
                    <span><strong>ভেন্যু:</strong> মেটলাইফ স্টেডিয়াম, নিউ জার্সি (ইউএসএ)</span>
                </div>
            </div>
        </header>

        <!-- ================= LAYER 1: REGULAR MATCH SITUATION ================= -->
        <section class="space-y-6">
            <div class="inline-flex items-center space-x-2 px-4 py-2 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 font-bold text-sm sm:text-base font-poppins">
                <span>🛡️</span>
                <span>লামিন ইয়ামাল বনাম আলবিসেলেস্তে ডিফেন্স (Regular Match)</span>
            </div>

            <div class="glass-card p-6 sm:p-8 rounded-3xl border border-slate-800 shadow-xl space-y-3">
                <div class="inline-flex items-center space-x-2 text-amber-400 text-lg sm:text-xl font-bold font-poppins">
                    <span>⚽</span>
                    <h3>ম্যাচ ব্যাকগ্রাউন্ড ১: মেটলাইফের মহাকাব্যিক থ্রিলার</h3>
                </div>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-sans">
                    বাংলাদেশের চিরসবুজ গালিচা আর মনকাড়া প্রকৃতি থেকে ঠিক ১২,৬৮৫ কিলোমিটার দূরে, সুদূর আমেরিকার নিউ জার্সির মেটলাইফ স্টেডিয়ামে বসেছে বিশ্ব ফুটবলের সবচেয়ে জমকালো আসর। ঘড়ির কাঁটায় তখন বাংলাদেশ সময় ২০ জুলাই, ২০২৬-এর ঠিক রাত ১:০০ টা। মুখোমুখি ডিফেন্ডিং চ্যাম্পিয়ন আর্জেন্টিনা এবং ইউরোপসেরা স্পেন। একদিকে আলবিসেলেস্তেদের মুকুট ধরে রাখার নিখুঁত প্রেস, অন্যদিকে লা রোহাদের গতিময় ফুটবল। কিন্তু এই রাজকীয় লড়াইয়ের পরতে পরতে লুকিয়ে আছে বলবিদ্যার কিছু জটিল সমীকরণ। মাঠের সেই টানটান উত্তেজনার দুটি দৃশ্যপট নিচে দেওয়া হলো:
                </p>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:gap-6">
                <!-- Event 1 -->
                <div class="glass-card p-6 sm:p-7 rounded-2xl border border-slate-800/80 hover:border-amber-500/40 transition duration-300 space-y-2">
                    <div class="flex items-center space-x-3">
                        <span class="px-3 py-1 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold font-poppins uppercase">
                            ঘটনা ১
                        </span>
                        <h4 class="text-base sm:text-lg font-bold text-white font-poppins">লামিন ইয়ামাল ও দানি ওলমোর বৃত্তাকার কম্বিনেশন এবং ডি পলের ডিফেন্স</h4>
                    </div>
                    <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-sans pt-1">
                        স্পেনের বিস্ময়বালক লামিন ইয়ামাল <strong class="text-amber-300">ভর 72 kg</strong> নিয়ে মাঠের ডান প্রান্ত দিয়ে <strong class="text-amber-300">6 ms⁻¹</strong> সমবেগে <strong class="text-amber-300">4 m</strong> ব্যাসার্ধের একটি বৃত্তাকার বক্রপথে উইং ধরে ড্রিবলিং করে ডিফেন্ডারকে পরাস্ত করেন এবং ফাঁকায় থাকা দানি ওলমোকে পাস দেন। ওলমো বলটি রিসিভ করে দিক পরিবর্তন করার মুহূর্তেই আর্জেন্টিনার রদ্রিগো ডি পল ওলমোকে থামাতে মাঠের সমান্তরালে ছুটে এসে বডি ট্যাকল করার চেষ্টা করেন। স্প্যানিশ ফরোয়ার্ডদের এই তীব্র ঘূর্ণন গতি বজায় রাখতে বুট ও মাঠের ঘাসের মধ্যকার স্থিতি ঘর্ষণ বলই একমাত্র ভরসা।
                    </p>
                </div>

                <!-- Event 2 -->
                <div class="glass-card p-6 sm:p-7 rounded-2xl border border-slate-800/80 hover:border-amber-500/40 transition duration-300 space-y-2">
                    <div class="flex items-center space-x-3">
                        <span class="px-3 py-1 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold font-poppins uppercase">
                            ঘটনা ২
                        </span>
                        <h4 class="text-base sm:text-lg font-bold text-white font-poppins">মেসির পাস, লাউতারোর বুলেট শট ও জালের স্প্রিং অ্যাকশন</h4>
                    </div>
                    <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-sans pt-1">
                        মাঝমাঠ থেকে লিওনেল মেসি জাদুকরী ড্রিবলিংয়ে বল পাস করলেন লাউতারো মার্টিনেজের উদ্দেশ্যে। লাউতারো ডি-বক্সের ভেতর স্থির থাকা <strong class="text-amber-300">450 g</strong> ভরের বলটিতে বুট দিয়ে প্রচণ্ড জোরে কিক করলেন। তার পা বলটির সংস্পর্শে মাত্র <strong class="text-amber-300">0.015 s</strong> ছিল এবং বলটি <strong class="text-amber-300">32 ms⁻¹</strong> অনুভূমিক বেগে গোলপোস্টের দিকে ছুটে যায়। বলটি গোলপোস্টের নাইলনের জালে আঘাত করা মাত্র জালটি একটি আদর্শ স্প্রিংয়ের মতো আচরণ করে সংকুচিত হয়ে বলটিকে থামিয়ে দেয়। জালের স্প্রিং ধ্রুবক <strong class="text-amber-300">k = 4608 Nm⁻¹</strong>।
                    </p>
                </div>
            </div>
        </section>

        <!-- ================= LAYER 2: PENALTY SHOOTOUT (TIE BREAKER) ================= -->
        <section class="space-y-6 pt-4">
            <div class="inline-flex items-center space-x-2 px-4 py-2 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 font-bold text-sm sm:text-base font-poppins">
                <span>🧤</span>
                <span>টাইব্রেকার থ্রিলার (Penalty Shootout)</span>
            </div>

            <div class="glass-card p-6 sm:p-8 rounded-3xl border border-slate-800 shadow-xl space-y-3">
                <div class="inline-flex items-center space-x-2 text-red-400 text-lg sm:text-xl font-bold font-poppins">
                    <span>⚽</span>
                    <h3>ম্যাচ ব্যাকগ্রাউন্ড ২: ১২০ মিনিটের মহানাটক ও স্পট কিক</h3>
                </div>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-sans">
                    নির্ধারিত ও অতিরিক্ত সময় শেষেও ম্যাচ ৩-৩ সমতায় শেষ হওয়ায় মেটলাইফ স্টেডিয়ামের ভাগ্য নির্ধারণের খেলা গড়াল টাইব্রেকারে। স্নায়ুচাপের এই চূড়ান্ত মুহূর্তে কিকারের শটের লিনিয়ার মেকানিক্স এবং গোলরক্ষকের রৈখিক গতির হিসাবই গড়ে দেবে ব্যবধান।
                </p>
            </div>

            <!-- Event 3 -->
            <div class="glass-card p-6 sm:p-7 rounded-2xl border border-slate-800/80 hover:border-red-500/40 transition duration-300 space-y-2">
                <div class="flex items-center space-x-3">
                    <span class="px-3 py-1 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold font-poppins uppercase">
                        ঘটনা ৩
                    </span>
                    <h4 class="text-base sm:text-lg font-bold text-white font-poppins">এমি মার্টিনেজের বাজপাখি ডাইভ</h4>
                </div>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-sans pt-1">
                    টাইব্রেকারের শেষ ও নিষ্পত্তিমূলক শট নিতে এলেন স্পেনের তারকা মিডফিল্ডার রদ্রি। গোলপোস্টের ঠিক <strong class="text-red-400">11 m</strong> দূরে থাকা পেনাল্টি স্পট থেকে তিনি বলটিকে অনুভূমিকভাবে সরাসরি পোস্টের ডান কোণা লক্ষ্য করে শট নিলেন। বলটি শট হওয়ার সাথে সাথে <strong class="text-red-400">0.25 s</strong> এর মধ্যে গোললাইন অতিক্রম করার জন্য ধাবিত হয়। আর্জেন্টিনার বাজপাখি গোলরক্ষক এমিলিয়ানো মার্টিনেজ বল ছুটার ঠিক <strong class="text-red-400">0.05 s</strong> পর (রিফ্লেক্স টাইম) গোলপোস্টের মাঝখান থেকে ডানদিকে <strong class="text-red-400">6 ms⁻¹</strong> সুষম বেগে ঝাঁপিয়ে পড়লেন। গোলপোস্টের কেন্দ্র থেকে ডান কোণার দূরত্ব <strong class="text-red-400">3.66 m</strong>।
                </p>
            </div>

            <p class="text-center text-xs sm:text-sm text-amber-300/80 font-mono pt-2">
                *(ধরে নাও, অভিকর্ষজ ত্বরণ <strong class="text-amber-300">g = 9.8 ms⁻²</strong>, সমস্ত শক্তি লস উপেক্ষণীয় এবং অনুভূমিক গতির ক্ষেত্রে বাতাসের বাধা নেই)*
            </p>
        </section>

        <!-- Match Action Images -->
        <section class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="glass-card p-3 rounded-2xl border border-slate-800/80 overflow-hidden shadow-lg group">
                <img class="w-full h-64 sm:h-72 object-contain rounded-xl group-hover:scale-105 transition duration-500 crisp-img" src="/images/finalaction1.jpg" alt="Final Action 1">
            </div>
            <div class="glass-card p-3 rounded-2xl border border-slate-800/80 overflow-hidden shadow-lg group">
                <img class="w-full h-64 sm:h-72 object-contain rounded-xl group-hover:scale-105 transition duration-500 crisp-img" src="/images/finalaction2.jpg" alt="Final Action 2">
            </div>
        </section>
        

        <!-- Questions / Challenges Section -->
        <section class="glass-card p-6 sm:p-10 rounded-3xl border border-red-500/30 shadow-2xl space-y-6">
            <div class="flex items-center space-x-3 pb-2 border-b border-slate-800">
                <span class="text-2xl text-red-400">❓</span>
                <h3 class="text-xl sm:text-2xl font-black text-white font-poppins">মেকানিক্স ও স্প্রিং চ্যালেঞ্জ (Double Layer Physics Challenges)</h3>
            </div>

            <div class="space-y-8">
                <!-- Part 1 Questions -->
                <div class="space-y-4">
                    <h4 class="text-amber-400 font-bold text-base sm:text-lg font-poppins flex items-center space-x-2">
                        <span>🔹</span>
                        <span>পার্ট-১: অন-ফিল্ড গতি ও শক্তি বিশ্লেষণ (Regular Match)</span>
                    </h4>

                    <div class="space-y-4">
                        <div class="bg-slate-950/60 p-5 sm:p-6 rounded-2xl border border-slate-800 space-y-2">
                            <div class="inline-block px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold font-poppins">
                                প্রশ্ন (ক)
                            </div>
                            <p class="text-slate-200 text-sm sm:text-base leading-relaxed font-sans">
                                ঘটনা ১ অনুযায়ী, লামিন ইয়ামাল যখন বক্রপথে বাঁক নিচ্ছিলেন তখন তার ওপর প্রযুক্ত কেন্দ্রমুখী বলের (Centripetal Force) মান কত ছিল? ইয়ামাল যদি না পিছলে ওই নির্দিষ্ট বেগে মোড় শেষ করতে চান, তবে বুট ও মাঠের ঘাসের মধ্যকার ন্যূনতম স্থিতি ঘর্ষণ গুণাঙ্ক (&mu;<sub>s</sub>) কত হতে হবে?
                            </p>
                        </div>

                        <div class="bg-slate-950/60 p-5 sm:p-6 rounded-2xl border border-slate-800 space-y-2">
                            <div class="inline-block px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold font-poppins">
                                প্রশ্ন (খ)
                            </div>
                            <p class="text-slate-200 text-sm sm:text-base leading-relaxed font-sans">
                                ঘটনা ২ এর তথ্যের ভিত্তিতে, লাউতারো মার্টিনেজের শটের কারণে বলের ওপর প্রযুক্ত বলের ঘাত (Impulse) এবং গড় বলের (Average Force) মান নির্ণয় করো। কাজ-শক্তি উপপাদ্য ব্যবহার করে বলটি জালের সংস্পর্শে এসে স্থির হওয়ার পূর্ব পর্যন্ত গোলপোস্টের জালটি সর্বোচ্চ কত দূরত্ব (x) সংকুচিত হয়েছিল তা বের করো।
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Part 2 Questions -->
                <div class="space-y-4">
                    <h4 class="text-red-400 font-bold text-base sm:text-lg font-poppins flex items-center space-x-2">
                        <span>🔹</span>
                        <span>পার্ট-২: টাইব্রেকার ও লিনিয়ার মেকানিক্স (Tie Breaker)</span>
                    </h4>

                    <div class="bg-slate-950/60 p-5 sm:p-6 rounded-2xl border border-slate-800 space-y-2">
                        <div class="inline-block px-3 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold font-poppins">
                            প্রশ্ন (গ)
                        </div>
                        <p class="text-slate-200 text-sm sm:text-base leading-relaxed font-sans">
