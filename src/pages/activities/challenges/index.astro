---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Physics Challenges & Contests - CCPAC | Chittagong College Physics & Astronomy Club" activePage="explore">


    <!-- Glowing Background Effect -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1400px] h-[600px] bg-cyan-500/10 blur-[200px] rounded-full"></div>
    </div>

    <!-- Navigation Bar (Matched with Home Page) -->
    

    <!-- Back to Activities -->
    <div class="max-w-6xl mx-auto px-6 pt-8">
        <a href="/activities" class="inline-flex items-center space-x-2 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition font-sans">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to Activities</span>
        </a>
    </div>

    <!-- Hero Section -->
    <section class="max-w-5xl mx-auto px-6 pt-8 pb-10 text-center space-y-6">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">
            <i class="fa-solid fa-brain"></i>
            <span>Analytical & Problem-Solving Track</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 uppercase font-poppins">
            Physics Challenges & Contests
        </h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto font-sans leading-relaxed">
            Sharpen your problem-solving skills with CCPAC’s Weekly Physics Challenges and special sports-physics contest series.
        </p>
    </section>

    <!-- SPECIAL CONTESTS SECTION (FIFA WORLD CUP 2026 SPECIALS) -->
    <section class="max-w-6xl mx-auto px-6 py-4 space-y-12">
        <div class="text-center space-y-2">
            <span class="px-4 py-1.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 text-xs font-bold uppercase tracking-widest font-poppins">
                <i class="fa-solid fa-star mr-1"></i> Special Contests & Editions
            </span>
            <h2 class="text-2xl sm:text-4xl font-black text-white mt-3 font-poppins">
                FIFA World Cup 2026 Physics Specials
            </h2>
            <p class="text-slate-400 text-sm font-sans">Interactive sports-mechanics physics showdowns (View full details inside)</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

            <!-- Grand Final Special Card -->
            <div class="glass-card rounded-3xl border border-red-500/40 shadow-2xl overflow-hidden glow-box p-6 sm:p-8 flex flex-col justify-between space-y-6">
                <div class="space-y-4">
                    <div class="flex justify-between items-center">
                        <span class="px-3 py-1 rounded-full bg-red-500/20 text-red-400 border border-red-500/30 text-xs font-bold uppercase font-poppins">Grand Final Special</span>
                        <span class="text-xs text-amber-400 font-semibold font-sans">🗓️ ২০ জুলাই, ২০২৬</span>
                    </div>
                    <h3 class="text-2xl font-black text-white leading-snug font-poppins">FIFA World Cup 2026 Grand Final: স্পেন বনাম আর্জেন্টিনা</h3>
                    <p class="text-slate-300 text-sm leading-relaxed font-sans">
                        মেটলাইফ স্টেডিয়ামে ফাইনালের টানটান উত্তেজনার মাঝে লামিন ইয়ামাল, লাউতারো ও এমি মার্টিনেজের ওপর মেকানিক্স ও স্প্রিং চ্যালেঞ্জ।
                    </p>
                </div>
                <div>
                    <a href="/activities/challenges/final" class="inline-flex items-center justify-center space-x-2 bg-gradient-to-r from-red-500 to-amber-600 hover:from-red-400 hover:to-amber-500 text-slate-950 font-bold px-5 py-3 rounded-xl text-sm transition shadow-lg shadow-red-500/25 w-full cursor-pointer font-poppins">
                        <span>View Grand Final Inside</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </a>
                </div>
            </div>

            <!-- Semifinal Special Card -->
            <div class="glass-card rounded-3xl border border-cyan-500/40 shadow-2xl overflow-hidden glow-box p-6 sm:p-8 flex flex-col justify-between space-y-6">
                <div class="space-y-4">
                    <div class="flex justify-between items-center">
                        <span class="px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-bold uppercase font-poppins">Semifinal Special</span>
                        <span class="text-xs text-amber-400 font-semibold font-sans">🗓️ ১৬ জুলাই, ২০২৬</span>
                    </div>
                    <h3 class="text-2xl font-black text-white leading-snug font-poppins">FIFA World Cup 2026 Semifinal: আর্জেন্টিনা বনাম ইংল্যান্ড</h3>
                    <p class="text-slate-300 text-sm leading-relaxed font-sans">
                        মেসির ফ্রি-কিক, বেলিংহামের ডিফেন্স এবং কেইন-আলভারেজের আপেক্ষিক বেগ ও প্রাসের গতিপথ সম্পর্কিত প্রবলেম সেট।
                    </p>
                </div>
                <div>
                    <a href="/activities/challenges/semi" class="inline-flex items-center justify-center space-x-2 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold px-5 py-3 rounded-xl text-sm transition shadow-lg shadow-cyan-500/25 w-full cursor-pointer font-poppins">
                        <span>View Semifinal Inside</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </a>
                </div>
            </div>

        </div>
    </section>

    <!-- WEEKLY PHYSICS CHALLENGES ARCHIVE (5 TO 1) -->
    <section class="max-w-6xl mx-auto px-6 py-12 space-y-12">
        <div class="text-center space-y-2">
            <h2 class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400 font-poppins">
                Weekly Physics Challenge Archive
            </h2>
            <p class="text-slate-400 text-sm font-sans">Explore our curated weekly problem sets from 1st to 5th challenge</p>
        </div>

        <!-- 5th Weekly Physics Challenge -->
        <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl glow-box">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-5 relative group flex items-center justify-center bg-slate-950/80 rounded-2xl border-2 border-cyan-500/40 p-4 shadow-xl overflow-hidden min-h-[450px]">
                    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-20 group-hover:opacity-40 transition duration-500"></div>
                    <img src="/images/wk5.jpeg" alt="5th Weekly Physics Challenge" class="relative w-full h-auto max-h-[500px] object-contain rounded-xl crisp-img">
                </div>
                <div class="lg:col-span-7 space-y-4">
                    <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase font-poppins">
                        Problem Set #05
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-black text-white font-poppins">5th Weekly Physics Challenge</h2>
                    <div class="space-y-3 text-sm text-slate-300 bg-slate-950/60 p-5 rounded-2xl border border-slate-800/80 font-sans">
                        <p><strong class="text-cyan-400"><i class="fa-solid fa-book-open mr-2"></i> Topic:</strong> Equilibrium & Collision</p>
                        <p class="text-slate-400 text-xs leading-relaxed pt-2">Engage with advanced mechanics problems focusing on equilibrium states, momentum transfer, and collision dynamics.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4th Weekly Physics Challenge -->
        <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl glow-box">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-7 space-y-4 order-2 lg:order-1">
                    <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase font-poppins">
                        Problem Set #04
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-black text-white font-poppins">4th Weekly Physics Challenge</h2>
                    <div class="space-y-3 text-sm text-slate-300 bg-slate-950/60 p-5 rounded-2xl border border-slate-800/80 font-sans">
                        <p><strong class="text-cyan-400"><i class="fa-solid fa-book-open mr-2"></i> Topic:</strong> Gravitation and Orbital Mechanics</p>
                        <p class="text-slate-400 text-xs leading-relaxed pt-2">Explore orbital parameters, gravitational fields, escape velocities, and planetary motion.</p>
                    </div>
                </div>
                <div class="lg:col-span-5 relative group order-1 lg:order-2 flex items-center justify-center bg-slate-950/80 rounded-2xl border-2 border-cyan-500/40 p-4 shadow-xl overflow-hidden min-h-[450px]">
                    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-20 group-hover:opacity-40 transition duration-500"></div>
                    <img src="/images/wk4.jpeg" alt="4th Weekly Physics Challenge" class="relative w-full h-auto max-h-[500px] object-contain rounded-xl crisp-img">
                </div>
            </div>
        </div>

        <!-- 3rd Weekly Physics Challenge -->
        <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl glow-box">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-5 relative group flex items-center justify-center bg-slate-950/80 rounded-2xl border-2 border-cyan-500/40 p-4 shadow-xl overflow-hidden min-h-[450px]">
                    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-20 group-hover:opacity-40 transition duration-500"></div>
                    <img src="/images/wk3.jpeg" alt="3rd Weekly Physics Challenge" class="relative w-full h-auto max-h-[500px] object-contain rounded-xl crisp-img">
                </div>
                <div class="lg:col-span-7 space-y-4">
                    <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase font-poppins">
                        Problem Set #03
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-black text-white font-poppins">3rd Weekly Physics Challenge</h2>
                    <div class="space-y-3 text-sm text-slate-300 bg-slate-950/60 p-5 rounded-2xl border border-slate-800/80 font-sans">
                        <p><strong class="text-cyan-400"><i class="fa-solid fa-book-open mr-2"></i> Topic:</strong> Classical Mechanics and Electromagnetism</p>
                        <p class="text-slate-400 text-xs leading-relaxed pt-2">Solve intricate problems combining forces, motion, electromagnetic fields, and charged particle trajectories.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2nd Weekly Physics Challenge -->
        <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl glow-box">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-7 space-y-4 order-2 lg:order-1">
                    <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase font-poppins">
                        Problem Set #02
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-black text-white font-poppins">2nd Weekly Physics Challenge</h2>
                    <div class="space-y-3 text-sm text-slate-300 bg-slate-950/60 p-5 rounded-2xl border border-slate-800/80 font-sans">
                        <p><strong class="text-cyan-400"><i class="fa-solid fa-book-open mr-2"></i> Topic:</strong> Projectile Motion and Electrostatics</p>
                        <p class="text-slate-400 text-xs leading-relaxed pt-2">Tackle analytical questions involving trajectories, Coulomb's law, electric fields, and charge distributions.</p>
                    </div>
                </div>
                <div class="lg:col-span-5 relative group order-1 lg:order-2 flex items-center justify-center bg-slate-950/80 rounded-2xl border-2 border-cyan-500/40 p-4 shadow-xl overflow-hidden min-h-[450px]">
                    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-20 group-hover:opacity-40 transition duration-500"></div>
                    <img src="/images/wk2.jpeg" alt="2nd Weekly Physics Challenge" class="relative w-full h-auto max-h-[500px] object-contain rounded-xl crisp-img">
                </div>
            </div>
        </div>

        <!-- 1st Weekly Physics Challenge -->
        <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl glow-box">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-5 relative group flex items-center justify-center bg-slate-950/80 rounded-2xl border-2 border-cyan-500/40 p-4 shadow-xl overflow-hidden min-h-[450px]">
                    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-20 group-hover:opacity-40 transition duration-500"></div>
                    <img src="/images/wk1.jpeg" alt="1st Weekly Physics Challenge" class="relative w-full h-auto max-h-[500px] object-contain rounded-xl crisp-img">
                </div>
                <div class="lg:col-span-7 space-y-4">
                    <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase font-poppins">
                        Problem Set #01
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-black text-white font-poppins">1st Weekly Physics Challenge</h2>
                    <div class="space-y-3 text-sm text-slate-300 bg-slate-950/60 p-5 rounded-2xl border border-slate-800/80 font-sans">
                        <p><strong class="text-cyan-400"><i class="fa-solid fa-book-open mr-2"></i> Topic:</strong> Stratified Atmosphere and Particle Motion</p>
                        <p class="text-slate-400 text-xs leading-relaxed pt-2">Explore fluid statics in the atmosphere, barometric formulas, drag forces, and terminal velocities.</p>
                    </div>
                </div>
            </div>
        </div>

    </section>

    <!-- Professional Popup Membership Registration Modal -->
    

    <!-- Professional Footer (Matched with Home Page) -->
    

    <!-- JavaScript for Membership Form -->
    <script is:inline>
        // Toggle Membership Form Visibility
        function toggleMembershipForm() {
            const formModal = document.getElementById('membership-registration');
            const isHidden = formModal.classList.contains('hidden');
            
            if (isHidden) {
                formModal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                formModal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }
        }

        // Form Handler Script with Google Sheets Integration
        document.getElementById('ccpacMembershipForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = {
                name: document.getElementById('mName').value,
                email: document.getElementById('mEmail').value,
                hscYear: document.getElementById('mHscYear').value,
                section: document.getElementById('mSection').value,
                roll: document.getElementById('mRoll').value,
                phone: document.getElementById('mPhone').value,
                whatsapp: document.getElementById('mWhatsapp').value,
                skills: Array.from(document.querySelectorAll('input[name="skills"]:checked')).map(cb => cb.value).join(', '),
                skillDetails: document.getElementById('mSkillDetails').value,
                olympiad: document.getElementById('mOlympiad').value,
                pastClub: document.getElementById('mPastClub').value,
                whyJoin: document.getElementById('mWhyJoin').value
            };

            const submitBtn = this.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Submitting...</span>`;
            submitBtn.disabled = true;

            try {
                const BACKEND_URL = 'https://script.google.com/macros/s/AKfycbxNKEqhdDrRqTE0rjpdgsH8THqHvwjzBEQGBcmQMnV1LiZIqac_MIBE7Vpob9kKrcw/exec';

                await fetch(BACKEND_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                document.getElementById('ccpacMembershipForm').style.display = 'none';
                document.getElementById('mSuccessBox').classList.remove('hidden');

            } catch (error) {
                console.error('Submission error:', error);
                alert('Something went wrong. Please try again later.');
                submitBtn.innerHTML = originalBtnText;
                submitBtn.disabled = false;
            }
        });
    </script>

</BaseLayout>