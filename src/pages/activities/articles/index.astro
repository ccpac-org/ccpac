---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { articlesData } from '../../../data/articles';
---

<BaseLayout title="Scientific Articles - CCPAC | Chittagong College Physics & Astronomy Club" activePage="explore">

    <!-- Glowing Background Effect -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1400px] h-[600px] bg-cyan-500/10 blur-[200px] rounded-full"></div>
    </div>

    <!-- Back to Activities -->
    <div class="max-w-6xl mx-auto px-6 pt-8">
        <a href="/activities" class="inline-flex items-center space-x-2 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to Activities</span>
        </a>
    </div>

    <!-- Hero Section -->
    <section class="max-w-5xl mx-auto px-6 pt-8 pb-8 text-center space-y-4">
        <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 uppercase font-poppins">
            SCIENTIFIC ARTICLES
        </h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto font-sans leading-relaxed">
            CCPAC promotes scientific communication through article writing, giving members the opportunity to express ideas, summarize insights from sessions, and explain complex physics or astronomy concepts.
        </p>
    </section>

    <!-- Articles Grid Section -->
    <section class="max-w-7xl mx-auto px-6 py-4 space-y-12 pb-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Submit Article Card -->
            <div onclick="openSubmitArticleModal()" class="glass-card rounded-3xl border border-cyan-500/40 hover:border-cyan-400 shadow-2xl overflow-hidden glow-box flex flex-col justify-between group cursor-pointer transition-all duration-300 hover:scale-[1.02]">
                <div class="p-8 space-y-6 flex flex-col items-center text-center my-auto">
                    <div class="w-20 h-20 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-3xl group-hover:scale-110 group-hover:bg-cyan-500 group-hover:text-slate-950 transition duration-300 shadow-lg shadow-cyan-500/10">
                        <i class="fa-solid fa-pen-nib"></i>
                    </div>
                    <div class="space-y-2">
                        <span class="px-3 py-1 bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 rounded-full text-[10px] font-bold uppercase tracking-wider font-poppins">
                            Call for Submissions
                        </span>
                        <h3 class="text-xl font-black text-white font-poppins pt-1 group-hover:text-cyan-300 transition">
                            Submit Your Own Article
                        </h3>
                        <p class="text-slate-300 text-xs leading-relaxed font-sans max-w-xs mx-auto">
                            Got an interesting theory, summary, or astronomical observation? Share your research and writing with CCPAC members.
                        </p>
                    </div>
                </div>
                <div class="p-6 pt-0">
                    <button type="button" class="inline-flex items-center space-x-2 bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-slate-950 font-bold px-4 py-3 rounded-xl text-xs transition duration-300 w-full justify-center shadow-lg shadow-cyan-500/20">
                        <span>Submit Article</span>
                        <i class="fa-solid fa-paper-plane text-[10px]"></i>
                    </button>
                </div>
            </div>

            {articlesData.map((article) => (
                <div class={`glass-card rounded-3xl border ${article.category === 'Special Feature' ? 'border-cyan-500/40' : 'border-slate-800'} shadow-2xl overflow-hidden glow-box flex flex-col justify-between`}>
                    <div>
                        <div class="h-48 overflow-hidden bg-slate-950 border-b border-slate-800 relative group">
                            <img src={article.images[0]} alt={article.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500 crisp-img" />
                            <span class={`absolute top-4 left-4 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider font-poppins ${article.category === 'Special Feature' ? 'bg-cyan-500/20 border border-cyan-500/40 text-cyan-300' : 'bg-slate-900/80 backdrop-blur-md border border-slate-700 text-cyan-400'}`}>
                                {article.category === 'Special Feature' && <i class="fa-solid fa-star mr-1"></i>}
                                {article.category}
                            </span>
                        </div>
                        <div class="p-6 space-y-3 text-xs text-slate-300">
                            <h3 class="text-base font-bold text-white leading-snug font-poppins line-clamp-2">{article.title}</h3>
                            {article.authors.length > 0 && (
                                <p class="text-xs">
                                    <strong class="text-cyan-400">{article.authors.length > 1 ? 'Authors: ' : 'Author: '}</strong>
                                    {article.authors.map((author, index) => (
                                        <span>
                                            {author.name}{author.roll && <span class="text-slate-400"> (Roll: {author.roll})</span>}{index < article.authors.length - 1 ? ', ' : ''}
                                        </span>
                                    ))}
                                </p>
                            )}
                            <p class="text-slate-400 leading-relaxed line-clamp-3 font-sans pt-1">
                                {article.excerpt}
                            </p>
                        </div>
                    </div>
                    <div class="p-6 pt-0">
                        <a href={`/activities/articles/${article.id}`} class="inline-flex items-center space-x-2 bg-slate-900 hover:bg-cyan-500 hover:text-slate-950 text-slate-200 border border-slate-700 hover:border-cyan-400 font-bold px-4 py-2.5 rounded-xl text-xs transition duration-300 w-full justify-center">
                            <span>Read Article</span>
                            <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- Submit Article Google Form Modal -->
    <div id="submit-article-modal" class="modal fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center p-4">
        <div class="glass-card max-w-4xl w-full h-[90vh] rounded-3xl border border-slate-800 shadow-2xl p-4 md:p-6 relative flex flex-col space-y-4">
            <!-- Close Button -->
            <button onclick="closeSubmitArticleModal()" class="absolute top-4 right-4 bg-slate-900 hover:bg-cyan-500 hover:text-slate-950 text-slate-300 w-10 h-10 rounded-full flex items-center justify-center transition border border-slate-700 shadow-lg z-10 cursor-pointer">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>

            <!-- Modal Header -->
            <div class="text-left pr-12 space-y-1">
                <span class="px-3 py-1 bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 rounded-full text-xs font-bold uppercase tracking-wider font-poppins">
                    CCPAC Article Submission
                </span>
                <h2 class="text-xl md:text-2xl font-extrabold font-poppins text-slate-100">Submit Your Article</h2>
            </div>

            <!-- Embedded Google Form Container -->
            <div class="w-full flex-1 rounded-2xl overflow-hidden border border-slate-800 bg-white relative">
                <!-- Loading Spinner / Placeholder -->
                <div id="form-loader" class="absolute inset-0 bg-slate-950 flex flex-col items-center justify-center space-y-3 z-10 transition-opacity duration-300">
                    <i class="fa-solid fa-circle-notch fa-spin text-cyan-400 text-3xl"></i>
                    <p class="text-xs text-slate-400 font-poppins">Loading Article Submission Form...</p>
                </div>

                <iframe 
                    id="submit-article-iframe"
                    data-src="https://docs.google.com/forms/d/e/1FAIpQLSdYDetayP5rLj4orevV0wyN4YQKTiw5OIGZ8ybm26bwXHXWlQ/viewform?embedded=true" 
                    class="w-full h-full border-0" 
                    title="Article Submission Form"
                    onload="document.getElementById('form-loader')?.classList.add('hidden')">
                </iframe>
            </div>
        </div>
    </div>

    <script is:inline>
        let isFormLoaded = false;

        function openSubmitArticleModal() {
            const modal = document.getElementById('submit-article-modal');
            const iframe = document.getElementById('submit-article-iframe');

            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }

            // Lazy-load iframe source on first modal open
            if (iframe && !isFormLoaded) {
                const src = iframe.getAttribute('data-src');
                if (src) {
                    iframe.src = src;
                    isFormLoaded = true;
                }
            }
        }

        function closeSubmitArticleModal() {
            const modal = document.getElementById('submit-article-modal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        // Close on backdrop click
        document.getElementById('submit-article-modal')?.addEventListener('click', function (e) {
            if (e.target === this) {
                closeSubmitArticleModal();
            }
        });
    </script>

</BaseLayout>
