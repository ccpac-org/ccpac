---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Podcast - CCPAC | Chittagong College Physics & Astronomy Club" activePage="explore">


    <!-- Glowing Background Effect -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1400px] h-[600px] bg-gradient-to-r from-cyan-500/10 to-blue-600/10 blur-[220px] rounded-full pointer-events-none"></div>

    <!-- Navigation Bar -->
    

    <!-- Back to Activities -->
    <div class="max-w-6xl mx-auto px-6 pt-8">
        <a href="/activities" class="inline-flex items-center space-x-2 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition font-sans">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to Activities</span>
        </a>
    </div>

    <!-- Hero Section -->
    <section class="max-w-5xl mx-auto px-6 pt-8 pb-12 text-center space-y-6">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">
            <i class="fa-solid fa-podcast"></i>
            <span>EigenTalks Official Podcast</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 uppercase font-poppins">
            EigenTalks
        </h1>
        
        <div class="glass-card p-6 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl text-slate-300 text-sm sm:text-base leading-relaxed text-left space-y-4 relative overflow-hidden font-sans">
            <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none"></div>
            <p class="relative z-10">
                EigenTalks unites inspiring voices in meaningful conversations, highlighting individuals who have distinguished themselves across diverse fields. Through engaging discussions, their journeys unfold — revealing challenges, growth, and defining moments that shape who they are. Each episode creates a space for sharing authentic stories, thoughtful ideas, and practical insights that listeners can truly learn from. By presenting achievements alongside the effort and decisions behind them, the podcast offers clarity and motivation, encouraging students and science enthusiasts to explore deeply, think critically, and grow continuously.
            </p>
        </div>
    </section>

    <!-- Podcast Episodes Section -->
    <section class="max-w-6xl mx-auto px-6 py-8 space-y-16">
        <div class="text-center space-y-2">
            <h2 class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400 font-poppins">
                Featured Episodes
            </h2>
            <p class="text-slate-400 text-sm font-sans">Listen and watch our exclusive podcast conversations on YouTube</p>
        </div>

        <!-- Episode 2: Out of the Box -->
        <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl glow-box">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-7 space-y-5">
                    <div class="flex items-center space-x-3">
                        <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase tracking-wider font-poppins">
                            Episode 2
                        </span>
                    </div>
                    <h3 class="text-2xl sm:text-3xl font-black text-white leading-tight font-poppins">আউট অফ দ্য বক্স | Out of the Box</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-300 bg-slate-950/60 p-5 rounded-2xl border border-slate-800/80 font-sans">
                        <p><strong class="text-cyan-400"><i class="fa-solid fa-user-tag mr-2"></i> Guest:</strong> Ankon Dey Animesh</p>
                        <p><strong class="text-cyan-400"><i class="fa-solid fa-microphone mr-2"></i> Host:</strong> Sajjad Hosen Sakib</p>
                    </div>
                    <div class="pt-2 flex flex-wrap gap-4">
                        <a href="https://youtu.be/ObHHiHpdgzw?si=ZFEfeQz5eRuuB98m" target="_blank" class="inline-flex items-center space-x-2 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold px-6 py-3 rounded-xl text-sm transition shadow-lg shadow-cyan-500/25 font-poppins">
                            <i class="fa-brands fa-youtube text-lg"></i>
                            <span>Watch on YouTube</span>
                        </a>
                    </div>
                </div>
                <!-- YouTube Thumbnail Clickable Link -->
                <div class="lg:col-span-5 relative group">
                    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-30 group-hover:opacity-60 transition duration-500"></div>
                    <a href="https://youtu.be/ObHHiHpdgzw?si=ZFEfeQz5eRuuB98m" target="_blank" class="relative block rounded-2xl overflow-hidden border-2 border-cyan-500/40 bg-slate-950 shadow-xl group cursor-pointer">
                        <img src="https://img.youtube.com/vi/ObHHiHpdgzw/maxresdefault.jpg" alt="Episode 2 Thumbnail" class="w-full h-[260px] sm:h-[300px] object-cover group-hover:scale-105 transition duration-500 crisp-img">
                        <div class="absolute inset-0 bg-black/40 flex items-center justify-center group-hover:bg-black/20 transition">
                            <div class="w-16 h-16 rounded-full bg-red-600 text-white flex items-center justify-center shadow-lg transform group-hover:scale-110 transition">
                                <i class="fa-solid fa-play text-xl ml-1"></i>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <!-- Episode 1: From Curiosity to International Stage -->
        <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl glow-box">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <!-- YouTube Thumbnail Clickable Link -->
                <div class="lg:col-span-5 relative group order-2 lg:order-1">
                    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-30 group-hover:opacity-60 transition duration-500"></div>
                    <a href="https://youtu.be/PgEn9sULYfY?si=iQ3UxWcVynHfQI5G" target="_blank" class="relative block rounded-2xl overflow-hidden border-2 border-cyan-500/40 bg-slate-950 shadow-xl group cursor-pointer">
                        <img src="https://img.youtube.com/vi/PgEn9sULYfY/maxresdefault.jpg" alt="Episode 1 Thumbnail" class="w-full h-[260px] sm:h-[300px] object-cover group-hover:scale-105 transition duration-500 crisp-img">
                        <div class="absolute inset-0 bg-black/40 flex items-center justify-center group-hover:bg-black/20 transition">
                            <div class="w-16 h-16 rounded-full bg-red-600 text-white flex items-center justify-center shadow-lg transform group-hover:scale-110 transition">
                                <i class="fa-solid fa-play text-xl ml-1"></i>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="lg:col-span-7 space-y-5 order-1 lg:order-2">
                    <div class="flex items-center space-x-3">
                        <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase tracking-wider font-poppins">
                            Episode 1
                        </span>
                    </div>
                    <h3 class="text-2xl sm:text-3xl font-black text-white leading-tight font-poppins">কৌতূহল থেকে আন্তর্জাতিক অঙ্গনে | From Curiosity to International Stage</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-300 bg-slate-950/60 p-5 rounded-2xl border border-slate-800/80 font-sans">
                        <p><strong class="text-cyan-400"><i class="fa-solid fa-user-tag mr-2"></i> Guest:</strong> Mohammad Abdullah</p>
                        <p><strong class="text-cyan-400"><i class="fa-solid fa-microphone mr-2"></i> Host:</strong> Mashrukha Islam Chowdhury</p>
                    </div>
                    <div class="pt-2 flex flex-wrap gap-4">
                        <a href="https://youtu.be/PgEn9sULYfY?si=iQ3UxWcVynHfQI5G" target="_blank" class="inline-flex items-center space-x-2 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold px-6 py-3 rounded-xl text-sm transition shadow-lg shadow-cyan-500/25 font-poppins">
                            <i class="fa-brands fa-youtube text-lg"></i>
                            <span>Watch on YouTube</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </section>

    <!-- Professional Popup Membership Registration Modal -->
    

    <!-- Professional Footer -->
    

    <!-- JavaScript for Form Toggle & Google Sheets Integration -->
    <script is:inline>
        function toggleMembershipForm() {
            const formModal = document.getElementById('membership-registration');
            const isHidden = formModal.classList.contains('hidden');
            if (isHidden) {
                formModal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                formModal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }
        }

        document.getElementById('ccpacMembershipForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = {
                name: document.getElementById('mName').value,
                email: document.getElementById('mEmail').value,
                hscYear: document.getElementById('mHscYear').value,
                section: document.getElementById('mSection').value,
                roll: document.getElementById('mRoll').value,
                phone: document.getElementById('mPhone').value,
                whatsapp: document.getElementById('mWhatsapp').value,
                skills: Array.from(document.querySelectorAll('input[name="skills"]:checked')).map(cb => cb.value).join(', '),
                whyJoin: document.getElementById('mWhyJoin').value
            };

            const submitBtn = this.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Submitting...</span>`;
            submitBtn.disabled = true;

            try {
                const BACKEND_URL = 'https://script.google.com/macros/s/AKfycbxNKEqhdDrRqTE0rjpdgsH8THqHvwjzBEQGBcmQMnV1LiZIqac_MIBE7Vpob9kKrcw/exec';
                await fetch(BACKEND_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                document.getElementById('ccpacMembershipForm').style.display = 'none';
                document.getElementById('mSuccessBox').classList.remove('hidden');
            } catch (error) {
                console.error('Submission error:', error);
                alert('Something went wrong. Please try again later.');
                submitBtn.innerHTML = originalBtnText;
                submitBtn.disabled = false;
            }
        });
    </script>

</BaseLayout>