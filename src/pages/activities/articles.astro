            <div class="space-y-4 pr-8">
                <span class="px-3 py-1 rounded-full bg-slate-900 border border-slate-700 text-cyan-400 text-[10px] font-bold uppercase font-poppins inline-block">
                    Stellar Evolution Series
                </span>
                <h2 class="text-xl sm:text-2xl font-black text-white font-poppins leading-snug">
                    নক্ষত্রের বিবর্তন: নীহারিকা থেকে কৃষ্ণগহ্বর (তারার জীবনচক্র ও গঠন)
                </h2>
                <p class="text-xs text-cyan-400 font-semibold">Authors: Rajarshi Das Gupta <span class="text-slate-400">(Roll: 1202526010041)</span>, Efaj Mahadi Bhuiyan <span class="text-slate-400">(Roll: 1202526010128)</span></p>
                
                <!-- Image Slider for Stellar Evolution Modal (st0 to st6 and re0 to re6) -->
                <div class="slider-container relative w-full overflow-hidden rounded-2xl bg-slate-950 border border-slate-800">
                    <div class="slider-track flex transition-transform duration-500 ease-in-out">
                        <div class="slide min-w-full flex items-center justify-center bg-black"><img src="/images/st0.jpeg" alt="st0" class="max-w-full max-h-[400px] w-auto h-auto object-contain crisp-img"></div>
                        <div class="slide min-w-full flex items-center justify-center bg-black"><img src="/images/st1.jpeg" alt="st1" class="max-w-full max-h-[400px] w-auto h-auto object-contain crisp-img"></div>
                        <div class="slide min-w-full flex items-center justify-center bg-black"><img src="/images/st2.jpeg" alt="st2" class="max-w-full max-h-[400px] w-auto h-auto object-contain crisp-img"></div>
                        <div class="slide min-w-full flex items-center justify-center bg-black"><img src="/images/st3.jpeg" alt="st3" class="max-w-full max-h-[400px] w-auto h-auto object-contain crisp-img"></div>
                        <div class="slide min-w-full flex items-center justify-center bg-black"><img src="/images/st4.jpeg" alt="st4" class="max-w-full max-h-[400px] w-auto h-auto object-contain crisp-img"></div>
                        <div class="slide min-w-full flex items-center justify-center bg-black"><img src="/images/st5.jpeg" alt="st5" class="max-w-full max-h-[400px] w-auto h-auto object-contain crisp-img"></div>
                        <div class="slide min-w-full flex items-center justify-center bg-black"><img src="/images/st6.jpeg" alt="st6" class="max-w-full max-h-[400px] w-auto h-auto object-contain crisp-img"></div>
