---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Sessions - CCPAC | Chittagong College Physics & Astronomy Club" activePage="explore">


    <!-- Glowing Background Effect -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1400px] h-[600px] bg-cyan-500/10 blur-[200px] rounded-full"></div>
    </div>

    <!-- Navigation Bar -->
    

    <!-- Back to Activities -->
    <div class="max-w-6xl mx-auto px-6 pt-8">
        <a href="/activities" class="inline-flex items-center space-x-2 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition font-sans">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to Activities</span>
        </a>
    </div>

    <!-- Sessions Hero Section -->
    <section class="max-w-5xl mx-auto px-6 pt-8 pb-12 text-center space-y-6">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">
            <i class="fa-solid fa-chalkboard-user"></i>
            <span>Knowledge Sharing & Problem Solving</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 uppercase font-poppins">
            SESSIONS
        </h1>
        
        <!-- Intro Box -->
        <div class="glass-card p-6 sm:p-8 rounded-3xl border border-slate-800/80 shadow-2xl text-slate-300 text-sm sm:text-base leading-relaxed text-left space-y-4 font-sans">
            <div>
                <h3 class="text-white font-bold text-base mb-1 font-poppins">Academic Sessions</h3>
                <p>
                    CCPAC regularly conducts academic sessions on physics and astronomy, led by seniors, alumni, and invited instructors. These sessions cover a wide range of topics, from fundamental concepts to advanced research, providing members with insights into higher studies, scientific thinking, and real-world applications. Active participation is encouraged, allowing students to ask questions, engage in discussions, and explore ideas beyond textbooks.
                </p>
            </div>
            <div class="pt-2 border-t border-slate-800">
                <h3 class="text-white font-bold text-base mb-1 font-poppins">Olympiad Sessions</h3>
                <p>
                    To prepare members for local, national, and international physics competitions, CCPAC organizes dedicated Olympiad Sessions. These sessions focus on problem-solving techniques, conceptual clarity, and analytical skills. Members receive guidance from experienced seniors and alumni who have excelled in various Olympiads, helping them develop a competitive edge and deepen their understanding of physics.
                </p>
            </div>
        </div>
    </section>

    <!-- Sessions Showcase Feed -->
    <section class="max-w-6xl mx-auto px-6 py-4 space-y-12">
        <div class="text-center space-y-2">
            <h2 class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400 font-poppins">
                Conducted Sessions
            </h2>
            <p class="text-slate-400 text-sm font-sans">Explore our session archives and details</p>
        </div>

        <!-- Session 3: Ahnaf Fayaz (Swapped: Image Left, Text Right) -->
        <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl glow-box">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <!-- Image Column (Left) -->
                <div class="lg:col-span-5 space-y-4">
                    <div class="relative group flex justify-center items-center bg-slate-950/40 p-4 rounded-2xl border border-slate-800/80">
                        <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-30 group-hover:opacity-60 transition duration-500"></div>
                        <!-- f0 হলো মূল ১ নম্বর ছবি, বাদ দিয়ে f1 থেকে শুরু (f1 থেকে f13 মোট ১৩টি ছবি) -->
                        <img id="fayazImage" src="/images/f1.jpeg" alt="Mechanics Problems: A Casual Deep Dive" class="relative max-w-full max-h-[450px] w-auto h-auto object-contain rounded-xl border border-cyan-500/30 shadow-xl crisp-img">
                    </div>
                    <!-- Image Navigation Gallery Controls -->
                    <div class="flex items-center justify-between bg-slate-950/60 px-4 py-2 rounded-xl border border-slate-800/80 text-xs">
                        <button onclick="prevFayazImage()" class="px-3 py-1 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 rounded-lg border border-cyan-500/30 transition cursor-pointer">
                            <i class="fa-solid fa-chevron-left mr-1"></i> Prev
                        </button>
                        <span id="fayazImageCounter" class="text-slate-300 font-semibold font-poppins">Photo 1 of 13</span>
                        <button onclick="nextFayazImage()" class="px-3 py-1 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 rounded-lg border border-cyan-500/30 transition cursor-pointer">
                            Next <i class="fa-solid fa-chevron-right ml-1"></i>
                        </button>
                    </div>
                </div>

                <!-- Text Column (Right) -->
                <div class="lg:col-span-7 space-y-4">
                    <div class="flex flex-wrap gap-2 items-center">
                        <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase font-poppins">
                            <i class="fa-regular fa-calendar mr-1"></i> Session: 3 (09-04-2026)
                        </span>
                        <span class="px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-bold uppercase font-poppins">
                            Olympiad Session
                        </span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-black text-white font-poppins">Mechanics Problems: A Casual Deep Dive</h2>
                    
                    <!-- Info Block -->
                    <div class="space-y-3 text-sm text-slate-300 bg-slate-950/60 p-5 rounded-2xl border border-slate-800/80 font-sans">
                        <div class="flex items-start space-x-3">
                            <span class="text-cyan-400 font-bold min-w-[110px]"><i class="fa-solid fa-chalkboard-user mr-1.5"></i> Instructor:</span>
                            <span class="text-white font-semibold">Ahnaf Fayaz</span>
                        </div>
                        <div class="flex items-start space-x-3">
                            <span class="text-cyan-400 font-bold min-w-[110px]"><i class="fa-solid fa-graduation-cap mr-1.5"></i> Affiliation:</span>
                            <span>Mechanical Engineering, BUET ’25 <span class="text-slate-400">(Ex-Chittagong College ’25)</span></span>
                        </div>
                        <div class="flex items-start space-x-3">
                            <span class="text-cyan-400 font-bold min-w-[110px]"><i class="fa-solid fa-award mr-1.5"></i> Achievement:</span>
                            <span class="text-cyan-300 font-medium">National Champion, BdPhO ’22</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Session 2: Enamul Hoque Jewel -->
        <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl glow-box">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-7 space-y-4 order-2 lg:order-1">
                    <div class="flex flex-wrap gap-2 items-center">
                        <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase font-poppins">
                            <i class="fa-regular fa-calendar mr-1"></i> Session: 2 (11-12-2025)
                        </span>
                        <span class="px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-bold uppercase font-poppins">
                            Advanced Physics Session
                        </span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-black text-white font-poppins">Particles in Nuclear Physics</h2>
                    
                    <!-- Info Block -->
                    <div class="space-y-3 text-sm text-slate-300 bg-slate-950/60 p-5 rounded-2xl border border-slate-800/80 font-sans">
                        <div class="flex items-start space-x-3">
                            <span class="text-cyan-400 font-bold min-w-[110px]"><i class="fa-solid fa-chalkboard-user mr-1.5"></i> Instructor:</span>
                            <span class="text-white font-semibold">Enamul Hoque Jewel</span>
                        </div>
                        <div class="flex items-start space-x-3">
                            <span class="text-cyan-400 font-bold min-w-[110px]"><i class="fa-solid fa-graduation-cap mr-1.5"></i> Affiliation:</span>
                            <span>Nuclear Engineering, University of Dhaka <span class="text-slate-400">(Batch 103)</span></span>
                        </div>
                        <div class="flex items-start space-x-3">
                            <span class="text-cyan-400 font-bold min-w-[110px]"><i class="fa-solid fa-building-columns mr-1.5"></i> Alumnus:</span>
                            <span>Chittagong College ’23</span>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-5 space-y-4 order-1 lg:order-2">
                    <div class="relative group flex justify-center items-center bg-slate-950/40 p-4 rounded-2xl border border-slate-800/80">
                        <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-30 group-hover:opacity-60 transition duration-500"></div>
                        <img id="jewelImage" src="/images/j1.jpeg" alt="Particles in Nuclear Physics" class="relative max-w-full max-h-[450px] w-auto h-auto object-contain rounded-xl border border-cyan-500/30 shadow-xl crisp-img">
                    </div>
                    <!-- Image Navigation Gallery Controls for Jewel -->
                    <div class="flex items-center justify-between bg-slate-950/60 px-4 py-2 rounded-xl border border-slate-800/80 text-xs">
                        <button onclick="prevJewelImage()" class="px-3 py-1 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 rounded-lg border border-cyan-500/30 transition cursor-pointer">
                            <i class="fa-solid fa-chevron-left mr-1"></i> Prev
                        </button>
                        <span id="jewelImageCounter" class="text-slate-300 font-semibold font-poppins">Photo 1 of 7</span>
                        <button onclick="nextJewelImage()" class="px-3 py-1 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 rounded-lg border border-cyan-500/30 transition cursor-pointer">
                            Next <i class="fa-solid fa-chevron-right ml-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Session 1: Srishti Bhattacharjee Ichchha -->
        <div class="glass-card p-8 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl glow-box">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-5 space-y-4">
                    <div class="relative group flex justify-center items-center bg-slate-950/40 p-4 rounded-2xl border border-slate-800/80">
                        <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-30 group-hover:opacity-60 transition duration-500"></div>
                        <img id="srishtiImage" src="/images/s1.jpeg" alt="Celestial Mechanics" class="relative max-w-full max-h-[450px] w-auto h-auto object-contain rounded-xl border border-cyan-500/30 shadow-xl crisp-img">
                    </div>
                    <!-- Image Navigation Gallery Controls -->
                    <div class="flex items-center justify-between bg-slate-950/60 px-4 py-2 rounded-xl border border-slate-800/80 text-xs">
                        <button onclick="prevSrishtiImage()" class="px-3 py-1 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 rounded-lg border border-cyan-500/30 transition cursor-pointer">
                            <i class="fa-solid fa-chevron-left mr-1"></i> Prev
                        </button>
                        <span id="srishtiImageCounter" class="text-slate-300 font-semibold font-poppins">Photo 1 of 8</span>
                        <button onclick="nextSrishtiImage()" class="px-3 py-1 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 rounded-lg border border-cyan-500/30 transition cursor-pointer">
                            Next <i class="fa-solid fa-chevron-right ml-1"></i>
                        </button>
                    </div>
                </div>
                <div class="lg:col-span-7 space-y-4">
                    <div class="flex flex-wrap gap-2 items-center">
                        <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase font-poppins">
                            <i class="fa-regular fa-calendar mr-1"></i> Session: 1 (07-12-2025)
                        </span>
                        <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-xs font-bold uppercase font-poppins">
                            CCPAC Intro & Session
                        </span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-black text-white font-poppins">Celestial Mechanics</h2>
                    
                    <!-- Info Block -->
                    <div class="space-y-3 text-sm text-slate-300 bg-slate-950/60 p-5 rounded-2xl border border-slate-800/80 font-sans">
                        <div class="flex items-start space-x-3">
                            <span class="text-cyan-400 font-bold min-w-[110px]"><i class="fa-solid fa-chalkboard-user mr-1.5"></i> Instructor:</span>
                            <span class="text-white font-semibold">Srishti Bhattacharjee Ichchha</span>
                        </div>
                        <div class="flex items-start space-x-3">
                            <span class="text-cyan-400 font-bold min-w-[110px]"><i class="fa-solid fa-building-columns mr-1.5"></i> Institution:</span>
                            <span class="text-white">Chittagong College ’26</span>
                        </div>
                        <div class="flex items-start space-x-3">
                            <span class="text-cyan-400 font-bold min-w-[110px]"><i class="fa-solid fa-award mr-1.5"></i> Achievement:</span>
                            <span class="text-cyan-300 font-medium">BDOAA ’25 National Winner and TST Camper</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>

    <!-- Professional Popup Membership Registration Modal -->
    

    <!-- Professional Footer -->
    

    <!-- JavaScript for Membership Form & Image Gallery Sliders -->
    <script is:inline>
        // Fayaz's Session Gallery Images (f1 to f13 - Total 13 images)
        const fayazImages = [
            "/images/f1.jpeg",
            "/images/f2.jpeg",
            "/images/f3.jpeg",
            "/images/f4.jpeg",
            "/images/f5.jpeg",
            "/images/f6.jpeg",
            "/images/f7.jpeg",
            "/images/f8.jpeg",
            "/images/f9.jpeg",
            "/images/f10.jpeg",
            "/images/f11.jpeg",
            "/images/f12.jpeg",
            "/images/f13.jpeg"
        ];
        let currentFayazIndex = 0;

        function updateFayazGallery() {
            const imgElement = document.getElementById('fayazImage');
            const counterElement = document.getElementById('fayazImageCounter');
            imgElement.src = fayazImages[currentFayazIndex];
            counterElement.textContent = `Photo ${currentFayazIndex + 1} of ${fayazImages.length}`;
        }

        function nextFayazImage() {
            currentFayazIndex = (currentFayazIndex + 1) % fayazImages.length;
            updateFayazGallery();
        }

        function prevFayazImage() {
            currentFayazIndex = (currentFayazIndex - 1 + fayazImages.length) % fayazImages.length;
            updateFayazGallery();
        }

        // Jewel's Session Gallery Images (j1 to j7)
        const jewelImages = [
            "/images/j1.jpeg",
            "/images/j2.jpeg",
            "/images/j3.jpeg",
            "/images/j4.jpeg",
            "/images/j5.jpeg",
            "/images/j6.jpeg",
            "/images/j7.jpeg"
        ];
        let currentJewelIndex = 0;

        function updateJewelGallery() {
            const imgElement = document.getElementById('jewelImage');
            const counterElement = document.getElementById('jewelImageCounter');
            imgElement.src = jewelImages[currentJewelIndex];
            counterElement.textContent = `Photo ${currentJewelIndex + 1} of ${jewelImages.length}`;
        }

        function nextJewelImage() {
            currentJewelIndex = (currentJewelIndex + 1) % jewelImages.length;
            updateJewelGallery();
        }

        function prevJewelImage() {
            currentJewelIndex = (currentJewelIndex - 1 + jewelImages.length) % jewelImages.length;
            updateJewelGallery();
        }

        // Srishti's Session Gallery Images (s1 to s8)
        const srishtiImages = [
            "/images/s1.jpeg",
            "/images/s2.jpeg",
            "/images/s3.jpeg",
            "/images/s4.jpeg",
            "/images/s5.jpeg",
            "/images/s6.jpeg",
            "/images/s7.jpeg",
            "/images/s8.jpeg"
        ];
        let currentSrishtiIndex = 0;

        function updateSrishtiGallery() {
            const imgElement = document.getElementById('srishtiImage');
            const counterElement = document.getElementById('srishtiImageCounter');
            imgElement.src = srishtiImages[currentSrishtiIndex];
            counterElement.textContent = `Photo ${currentSrishtiIndex + 1} of ${srishtiImages.length}`;
        }

        function nextSrishtiImage() {
            currentSrishtiIndex = (currentSrishtiIndex + 1) % srishtiImages.length;
            updateSrishtiGallery();
        }

        function prevSrishtiImage() {
            currentSrishtiIndex = (currentSrishtiIndex - 1 + srishtiImages.length) % srishtiImages.length;
            updateSrishtiGallery();
        }

        // Toggle Membership Form Visibility
        function toggleMembershipForm() {
            const formModal = document.getElementById('membership-registration');
            const isHidden = formModal.classList.contains('hidden');
            
            if (isHidden) {
                formModal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                formModal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }
        }

        // Form Handler Script with Google Sheets Integration
        document.getElementById('ccpacMembershipForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = {
                name: document.getElementById('mName').value,
                email: document.getElementById('mEmail').value,
                hscYear: document.getElementById('mHscYear').value,
                section: document.getElementById('mSection').value,
                roll: document.getElementById('mRoll').value,
                phone: document.getElementById('mPhone').value,
                whatsapp: document.getElementById('mWhatsapp').value,
                skills: Array.from(document.querySelectorAll('input[name="skills"]:checked')).map(cb => cb.value).join(', '),
                skillDetails: document.getElementById('mSkillDetails').value,
                olympiad: document.getElementById('mOlympiad').value,
                pastClub: document.getElementById('mPastClub').value,
                whyJoin: document.getElementById('mWhyJoin').value
            };

            const submitBtn = this.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Submitting...</span>`;
            submitBtn.disabled = true;

            try {
                const BACKEND_URL = 'https://script.google.com/macros/s/AKfycbxNKEqhdDrRqTE0rjpdgsH8THqHvwjzBEQGBcmQMnV1LiZIqac_MIBE7Vpob9kKrcw/exec';

                await fetch(BACKEND_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                document.getElementById('ccpacMembershipForm').style.display = 'none';
                document.getElementById('mSuccessBox').classList.remove('hidden');

            } catch (error) {
                console.error('Submission error:', error);
                alert('Something went wrong. Please try again later.');
                submitBtn.innerHTML = originalBtnText;
                submitBtn.disabled = false;
            }
        });
    </script>

</BaseLayout>