---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Team - CCPAC | Chittagong College Physics & Astronomy Club" activePage="explore">


    <!-- Glowing Background Effect -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1400px] h-[600px] bg-cyan-500/10 blur-[200px] rounded-full pointer-events-none"></div>

    <!-- Navigation Bar -->
    

    <!-- Team Hero & Panel Intro Section -->
    <section class="max-w-5xl mx-auto px-6 pt-20 pb-14 text-center space-y-6">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">
            <i class="fa-solid fa-users-gear"></i>
            <span>LEADERSHIP & ADMINISTRATION</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 font-poppins">
            CCPAC Team
        </h1>
        <div class="glass-card p-6 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl text-slate-300 text-sm sm:text-base leading-relaxed text-left space-y-4 font-sans">
            <p>
                The CCPAC Team is embodied by our dynamic Executive Panel—serving as the core administrative and leadership backbone of the Chittagong College Physics & Astronomy Club. Assumed for a fixed tenure each year, this dedicated body takes charge of steering the club's vision, governance, and structural framework.
            </p>
            <p>
                Operating under the direct direction and supervision of the honourable club moderators and college administration, the Executive Panel manages overall club operations, strategic planning, and institutional coordination. They act as the primary bridge between general members, alumni, and governing authorities to ensure seamless administrative execution.
            </p>
            <p>
                Through structured teamwork and disciplined leadership, the Executive Panel maintains organizational excellence. Their commitment ensures that every administrative tier functions harmoniously, cultivating a robust environment dedicated to scientific inquiry, institutional discipline, and long-term community building.
            </p>
        </div>

        <!-- Glowing Interactive Core Pillars Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6">
            <div class="glass-card p-4 rounded-xl border border-slate-800 text-center glow-box">
                <i class="fa-solid fa-handshake text-cyan-400 text-xl mb-2"></i>
                <h4 class="text-xs font-extrabold text-cyan-300 tracking-wider uppercase font-poppins">Teamwork</h4>
            </div>
            <div class="glass-card p-4 rounded-xl border border-slate-800 text-center glow-box">
                <i class="fa-solid fa-chess-king text-cyan-400 text-xl mb-2"></i>
                <h4 class="text-xs font-extrabold text-cyan-300 tracking-wider uppercase font-poppins">Leadership</h4>
            </div>
            <div class="glass-card p-4 rounded-xl border border-slate-800 text-center glow-box">
                <i class="fa-solid fa-compass text-cyan-400 text-xl mb-2"></i>
                <h4 class="text-xs font-extrabold text-cyan-300 tracking-wider uppercase font-poppins">Guidance</h4>
            </div>
            <div class="glass-card p-4 rounded-xl border border-slate-800 text-center glow-box">
                <i class="fa-solid fa-life-ring text-cyan-400 text-xl mb-2"></i>
                <h4 class="text-xs font-extrabold text-cyan-300 tracking-wider uppercase font-poppins">Support</h4>
            </div>
            <div class="glass-card p-4 rounded-xl border border-slate-800 text-center glow-box">
                <i class="fa-solid fa-lightbulb text-cyan-400 text-xl mb-2"></i>
                <h4 class="text-xs font-extrabold text-cyan-300 tracking-wider uppercase font-poppins">Innovation</h4>
            </div>
            <div class="glass-card p-4 rounded-xl border border-slate-800 text-center glow-box">
                <i class="fa-solid fa-network-wired text-cyan-400 text-xl mb-2"></i>
                <h4 class="text-xs font-extrabold text-cyan-300 tracking-wider uppercase font-poppins">Coordination</h4>
            </div>
            <div class="glass-card p-4 rounded-xl border border-slate-800 text-center col-span-2 glow-box">
                <i class="fa-solid fa-trophy text-cyan-400 text-xl mb-2"></i>
                <h4 class="text-xs font-extrabold text-cyan-300 tracking-wider uppercase font-poppins">Achievements</h4>
            </div>
        </div>
    </section>

    <!-- Executive Panel Selection / Archive Directory -->
    <section class="max-w-5xl mx-auto px-6 py-12 space-y-8">
        <div class="text-center space-y-2">
            <h2 class="text-3xl sm:text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400 font-poppins">
                Select Executive Panel
            </h2>
            <p class="text-slate-400 text-sm font-sans">Explore committee members across different tenure years</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Panel 2025-26 Card -->
            <a href="/team/panel-2025-26" class="glass-card p-8 rounded-3xl border border-slate-800 hover:border-cyan-400/80 transition shadow-2xl group flex justify-between items-center glow-box">
                <div class="space-y-2">
                    <span class="text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">Active Panel</span>
                    <h3 class="text-2xl font-black text-white group-hover:text-cyan-300 transition font-poppins">Executive Panel 2025–26</h3>
                    <p class="text-slate-400 text-xs font-sans">Current administrative committee & members</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 group-hover:bg-cyan-500 group-hover:text-slate-950 transition">
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>

            <!-- Panel 2026-27 Card (Upcoming / Placeholder) -->
            <div class="glass-card p-8 rounded-3xl border border-slate-800/50 opacity-75 shadow-2xl flex justify-between items-center">
                <div class="space-y-2">
                    <span class="text-slate-500 text-xs font-bold uppercase tracking-widest font-poppins">Upcoming Panel</span>
                    <h3 class="text-2xl font-black text-slate-300 font-poppins">Executive Panel 2026–27</h3>
                    <p class="text-slate-500 text-xs font-sans">Will be announced soon</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-slate-800/50 border border-slate-700 flex items-center justify-center text-slate-500">
                    <i class="fa-solid fa-lock"></i>
                </div>
            </div>
        </div>
    </section>

    <!-- Professional Popup Membership Registration Modal -->
    

    <!-- Professional Footer -->
    

    <!-- JavaScript for Membership Form -->
    <script is:inline>
        // Toggle Membership Form Visibility
        function toggleMembershipForm() {
            const formModal = document.getElementById('membership-registration');
            const isHidden = formModal.classList.contains('hidden');
            
            if (isHidden) {
                formModal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                formModal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }
        }

        // Form Handler Script with Google Sheets Integration
        document.getElementById('ccpacMembershipForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = {
                name: document.getElementById('mName').value,
                email: document.getElementById('mEmail').value,
                hscYear: document.getElementById('mHscYear').value,
                section: document.getElementById('mSection').value,
                roll: document.getElementById('mRoll').value,
                phone: document.getElementById('mPhone').value,
                whatsapp: document.getElementById('mWhatsapp').value,
                skills: Array.from(document.querySelectorAll('input[name="skills"]:checked')).map(cb => cb.value).join(', '),
                skillDetails: document.getElementById('mSkillDetails').value,
                olympiad: document.getElementById('mOlympiad').value,
                pastClub: document.getElementById('mPastClub').value,
                whyJoin: document.getElementById('mWhyJoin').value
            };

            const submitBtn = this.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Submitting...</span>`;
            submitBtn.disabled = true;

            try {
                const BACKEND_URL = 'https://script.google.com/macros/s/AKfycbxNKEqhdDrRqTE0rjpdgsH8THqHvwjzBEQGBcmQMnV1LiZIqac_MIBE7Vpob9kKrcw/exec';

                await fetch(BACKEND_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                document.getElementById('ccpacMembershipForm').style.display = 'none';
                document.getElementById('mSuccessBox').classList.remove('hidden');

            } catch (error) {
                console.error('Submission error:', error);
                alert('Something went wrong. Please try again later.');
                submitBtn.innerHTML = originalBtnText;
                submitBtn.disabled = false;
            }
        });
    </script>

</BaseLayout>