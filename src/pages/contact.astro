---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us - CCPAC | Chittagong College Physics & Astronomy Club" activePage="explore">


    <!-- Glowing Background Effect -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1400px] h-[600px] bg-gradient-to-r from-cyan-500/10 to-blue-600/10 blur-[220px] rounded-full pointer-events-none"></div>

    <!-- Navigation Bar (Matched with Home Page) -->
    

    <!-- Hero Section -->
    <section class="max-w-4xl mx-auto px-6 pt-12 pb-8 text-center space-y-6 font-sans">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-bold uppercase tracking-widest font-poppins">
            <i class="fa-solid fa-headset"></i>
            <span>Get in Touch</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 uppercase font-poppins">
            Contact Us
        </h1>
        <div class="glass-card p-6 sm:p-8 rounded-3xl border border-slate-800/80 shadow-2xl text-slate-300 text-sm sm:text-base leading-relaxed space-y-3">
            <p>
                We welcome all curious minds who wish to connect with CCPAC. Whether you want to know more about our activities, membership process, sessions, or collaborations, feel free to reach out to us. Our team is always ready to respond to your queries and guide you in joining our scientific journey.
            </p>
            <p class="text-slate-400 text-xs sm:text-sm">
                You can contact us through our official email, social media platforms, or by visiting us during our regular meetings. We believe communication is the first step toward collaboration and discovery.
            </p>
        </div>
    </section>

    <!-- Social Media Links Bar -->
    <section class="max-w-4xl mx-auto px-6 py-4">
        <div class="glass-card p-6 rounded-3xl border border-slate-800 shadow-xl flex justify-center items-center flex-wrap gap-6 text-xl">
            <a href="https://www.facebook.com/ccpacofficial" target="_blank" class="w-12 h-12 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center text-cyan-400 hover:bg-cyan-500 hover:text-slate-950 transition shadow-md" title="Facebook">
                <i class="fa-brands fa-facebook-f"></i>
            </a>
            <a href="https://www.instagram.com/ccpac.official" target="_blank" class="w-12 h-12 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center text-cyan-400 hover:bg-cyan-500 hover:text-slate-950 transition shadow-md" title="Instagram">
                <i class="fa-brands fa-instagram"></i>
            </a>
            <a href="https://www.linkedin.com" target="_blank" class="w-12 h-12 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center text-cyan-400 hover:bg-cyan-500 hover:text-slate-950 transition shadow-md" title="LinkedIn">
                <i class="fa-brands fa-linkedin-in"></i>
            </a>
            <a href="mailto:ccpacofficial@gmail.com" class="w-12 h-12 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center text-cyan-400 hover:bg-cyan-500 hover:text-slate-950 transition shadow-md" title="Email">
                <i class="fa-solid fa-envelope"></i>
            </a>
            <a href="https://www.youtube.com/@ccpacofficial" target="_blank" class="w-12 h-12 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center text-cyan-400 hover:bg-cyan-500 hover:text-slate-950 transition shadow-md" title="YouTube">
                <i class="fa-brands fa-youtube"></i>
            </a>
        </div>
    </section>

    <!-- Google Map & Address Section -->
    <section class="max-w-5xl mx-auto px-6 py-8 space-y-8 font-sans">
        <div class="glass-card p-4 sm:p-6 rounded-3xl border border-slate-800 shadow-2xl space-y-6">
            <div class="text-center space-y-1">
                <h3 class="text-xl font-bold text-white font-poppins">Our Location</h3>
                <p class="text-slate-400 text-xs">Visit us at the Physics Department, Chittagong College</p>
            </div>
            
            <!-- Google Map Embed -->
            <div class="rounded-2xl overflow-hidden border border-cyan-500/30 shadow-lg h-[350px] w-full bg-slate-950">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3689.9056262973167!2d91.8385!3d22.3569!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x30acd8823b123456%3A0xabcdef123456789!2sChittagong%20College!5e0!3m2!1sen!2sbd!4v1700000000000!5m2!1sen!2sbd" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>

            <!-- Address Details Card -->
            <div class="bg-slate-950/80 p-6 rounded-2xl border border-slate-800 flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left">
                <div class="space-y-1">
                    <h4 class="text-cyan-400 font-bold text-base font-poppins"><i class="fa-solid fa-location-dot mr-2"></i>Chittagong College Physics & Astronomy Club</h4>
                    <p class="text-slate-300 text-xs sm:text-sm">Chittagong College, College Road, Chattogram.</p>
                </div>
                <div class="space-y-1">
                    <h4 class="text-cyan-400 font-bold text-base font-poppins"><i class="fa-solid fa-envelope mr-2"></i>Email Us</h4>
                    <a href="mailto:ccpacofficial@gmail.com" class="text-slate-300 hover:text-cyan-400 text-xs sm:text-sm transition">ccpacofficial@gmail.com</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Professional Footer (Matched with Home Page) -->
    

    <!-- Professional Popup Membership Registration Modal -->
    
    </div>

    <!-- JavaScript for Form Toggle & Google Sheets Submission -->
    <script is:inline>
        function toggleMembershipForm() {
            const formModal = document.getElementById('membership-registration');
            const isHidden = formModal.classList.contains('hidden');
            
            if (isHidden) {
                formModal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                formModal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }
        }

        document.getElementById('ccpacMembershipForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = {
                name: document.getElementById('mName').value,
                email: document.getElementById('mEmail').value,
                hscYear: document.getElementById('mHscYear').value,
                section: document.getElementById('mSection').value,
                roll: document.getElementById('mRoll').value,
                phone: document.getElementById('mPhone').value,
                whatsapp: document.getElementById('mWhatsapp').value,
                skills: Array.from(document.querySelectorAll('input[name="skills"]:checked')).map(cb => cb.value).join(', '),
                skillDetails: document.getElementById('mSkillDetails').value,
                olympiad: document.getElementById('mOlympiad').value,
                pastClub: document.getElementById('mPastClub').value,
                whyJoin: document.getElementById('mWhyJoin').value
            };

            const submitBtn = this.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Submitting...</span>`;
            submitBtn.disabled = true;

            try {
                const BACKEND_URL = 'https://script.google.com/macros/s/AKfycbxNKEqhdDrRqTE0rjpdgsH8THqHvwjzBEQGBcmQMnV1LiZIqac_MIBE7Vpob9kKrcw/exec';

                await fetch(BACKEND_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                document.getElementById('ccpacMembershipForm').style.display = 'none';
                document.getElementById('mSuccessBox').classList.remove('hidden');

            } catch (error) {
                console.error('Submission error:', error);
                alert('Something went wrong. Please try again later.');
                submitBtn.innerHTML = originalBtnText;
                submitBtn.disabled = false;
            }
        });
    </script>

</BaseLayout>
